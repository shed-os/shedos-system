# shellcheck shell=bash
# shedos-system install scriptlet
#
# Runs as root in the target install root. For a normal `pacman -S` this is
# the live system; during pacstrap it's the install target.

_add_shedos_repo() {
    # Skip when running inside the ShedOS package-build chroot. The build
    # script (scripts/build-shedos-packages.sh) creates this marker so the
    # scriptlet doesn't add the production repo to the build container's
    # /etc/pacman.conf; the next pacman -Sy inside makepkg would 404 on
    # a repo whose db doesn't yet exist (we're building what would land
    # there). Pacstrap and Calamares chroot into a target rootfs, so the
    # marker at container / isn't visible to them; they get normal behavior.
    [[ -e /.shedos-build-environment ]] && return 0

    # /etc/pacman.conf is owned by `pacman`. We append a fenced block.
    # The strip-then-append flow is idempotent AND handles bare [shedos]
    # blocks left behind by older airootfs templates (rc16 and earlier
    # baked one in, which collided with this hook's marker-fenced append
    # and produced `database already registered` from pacman -Sy).
    local pacman_conf=/etc/pacman.conf
    [[ -f $pacman_conf ]] || return 0
    local tmp
    tmp=$(mktemp)

    # Drop every existing [shedos] block (fenced or bare) so we end up
    # with at most one canonical block after appending below.
    awk '
        /^# >>> shedos <<<$/                  { skip=1; next }
        /^# <<< shedos >>>$/                  { skip=0; next }
        /^\[shedos\][[:space:]]*$/            { skip=2; next }
        skip==2 && (/^\[/ || /^[[:space:]]*$/) { skip=0 }
        !skip                                 { print }
    ' "$pacman_conf" > "$tmp"

    # Channel routing: an RC ISO bakes `test` into /etc/shedos/channel
    # (build-iso.yml) so its installs actually soak the RC packages;
    # everything else — stable ISOs, existing systems with no marker —
    # tracks /stable. The escaped \$arch stays literal for pacman.
    local channel="stable"
    if [[ "$(cat /etc/shedos/channel 2>/dev/null)" == "test" ]]; then
        channel="test"
    fi

    cat >> "$tmp" <<EOF

# >>> shedos <<<
# Managed by shedos-system; do not edit between these markers.
# Run \`pacman -R shedos-system\` to remove automatically.
[shedos]
SigLevel = Required DatabaseRequired
Server = https://repo.shedos.org/$channel/\$arch
# <<< shedos >>>
EOF
    install -Dm644 "$tmp" "$pacman_conf"
    rm -f "$tmp"

    # Also append a *commented-out* [shedostest] block so users who
    # want to opt into the canary channel can do so by uncommenting,
    # without having to remember the URL or SigLevel. Match either the
    # old or new marker so a migrated box never gets a duplicate.
    if ! grep -qE '^# >>> (shedos-testing|shedostest) <<<' "$pacman_conf"; then
        cat >>"$pacman_conf" <<'EOF'

# >>> shedostest <<<
# ShedOS canary channel; RC packages land here before reaching
# [shedos]. Uncomment the four lines below to opt in. Stable cuts
# also publish to /test/x86_64/, so opting in only changes
# behavior during RC windows.
#[shedostest]
#SigLevel = Required DatabaseRequired
#Server = https://repo.shedos.org/test/$arch
# <<< shedostest >>>
EOF
    fi
}

_migrate_repo_url() {
    # The literal `$arch` below is intentional: it's written into
    # /etc/pacman.conf, where pacman (not bash) expands it. Single quotes
    # keep it literal. The shedos-testing → shedostest renames run before
    # the URL fixups so the latter match the new markers; all idempotent.
    # shellcheck disable=SC2016
    sed -i \
        -e '/^# >>> shedos <<<$/,/^# <<< shedos >>>$/ s|^Server = https://repo\.shedos\.org/\$arch$|Server = https://repo.shedos.org/stable/$arch|' \
        -e 's|^# >>> shedos-testing <<<$|# >>> shedostest <<<|' \
        -e 's|^# <<< shedos-testing >>>$|# <<< shedostest >>>|' \
        -e 's|^\(#\?\)\[shedos-testing\]$|\1[shedostest]|' \
        -e '/^# >>> shedostest <<<$/,/^# <<< shedostest >>>$/ s|^#Server = https://repo\.shedos\.org/\$arch-testing$|#Server = https://repo.shedos.org/test/$arch|' \
        -e '/^# >>> shedostest <<<$/,/^# <<< shedostest >>>$/ s|/x86_64-testing/|/test/x86_64/|' \
        /etc/pacman.conf
}

_remove_shedos_repo() {
    # Strip the fenced block(s) on uninstall. sed operates on exact marker
    # ranges so a user who scribbles outside the blocks keeps their edits.
    # May leave a trailing blank line in /etc/pacman.conf; cosmetic only.
    if grep -q '^# >>> shedos <<<' /etc/pacman.conf; then
        sed -i '/^# >>> shedos <<<$/,/^# <<< shedos >>>$/d' /etc/pacman.conf
    fi
    if grep -q '^# >>> shedostest <<<' /etc/pacman.conf; then
        sed -i '/^# >>> shedostest <<<$/,/^# <<< shedostest >>>$/d' /etc/pacman.conf
    fi
    # Older boxes removed before they ever upgraded carry the old marker.
    if grep -q '^# >>> shedos-testing <<<' /etc/pacman.conf; then
        sed -i '/^# >>> shedos-testing <<<$/,/^# <<< shedos-testing >>>$/d' /etc/pacman.conf
    fi
}

_render_theme() {
    # Rebuild /etc/shedos/themes/current/ from system.toml [theme] +
    # the named palette. Best-effort: a missing python3 or theme module
    # just leaves the previous render in place.
    if [[ -x /usr/bin/python3 && -f /usr/lib/shedos/theme_renderer.py ]]; then
        /usr/bin/python3 /usr/lib/shedos/theme_renderer.py >/dev/null 2>&1 || true
    fi
}

_bootstrap_greetd() {
    # greetd reads our config via the drop-in; only PAM needs placing (its
    # service name is hardcoded). The marker seeds onto stock + self-heals.
    local pam_src=/usr/share/shedos/greetd/greetd.pam
    local pam_dst=/etc/pam.d/greetd
    if [[ -f $pam_src ]]; then
        if [[ ! -f $pam_dst ]] || ! grep -q 'shedos-managed' "$pam_dst"; then
            install -Dm644 "$pam_src" "$pam_dst"
        elif ! cmp -s "$pam_src" "$pam_dst"; then
            install -Dm644 "$pam_src" "$pam_dst.shedosnew"
        fi
    fi

    # The `greeter` system user (created by greetd's sysusers.d) needs:
    #   - `seat` ; talk to seatd, acquire a Wayland seat for cage
    #   - `video`; open /dev/dri/cardX for EGL/GBM
    #   - `input`; read /dev/input/event* for keyboard/touchpad
    # Without these the cage compositor fails with EGL_BAD_ALLOC and
    # libseat connect errors during boot.
    # `groupadd -r -f` ensures the groups exist before usermod runs;
    # seatd's sysusers.d may install the seat group AFTER shedos-system
    # in some pacman orderings, leaving usermod silently failing with
    # "group seat does not exist" and the greeter unable to acquire seat0.
    groupadd -r -f seat
    groupadd -r -f input
    groupadd -r -f video
    if id greeter &>/dev/null; then
        usermod -aG seat,video,input greeter 2>/dev/null || true
    fi
}

_bootstrap_snapper() {
    # Install the default snapper config for `/` on first install only. A
    # subsequent upgrade finds /etc/snapper/configs/root already present and
    # leaves it alone so user tuning sticks (retention limits, timeline
    # cadence, etc.). The template lives under /usr/share/shedos/snapper/
    # so we don't collide with the snapper package's ownership of
    # /etc/snapper/configs/.
    local tpl=/usr/share/shedos/snapper/root.conf
    local dst=/etc/snapper/configs/root
    [[ -f $tpl ]] || return 0

    if [[ ! -f $dst ]]; then
        install -Dm640 "$tpl" "$dst"
        chown root:root "$dst"
    fi

    # Point snapper at the root config. /etc/conf.d/snapper is shipped by
    # the snapper package with SNAPPER_CONFIGS="" by default.
    if [[ -f /etc/conf.d/snapper ]]; then
        if grep -q '^SNAPPER_CONFIGS=' /etc/conf.d/snapper; then
            # Merge 'root' into any existing list, preserving other entries.
            if ! grep -qE '^SNAPPER_CONFIGS="[^"]*\broot\b' /etc/conf.d/snapper; then
                sed -i -E \
                    's/^SNAPPER_CONFIGS="([^"]*)"/SNAPPER_CONFIGS="\1 root"/' \
                    /etc/conf.d/snapper
                # Squash leading space if the previous list was empty.
                sed -i -E 's/^SNAPPER_CONFIGS=" /SNAPPER_CONFIGS="/' \
                    /etc/conf.d/snapper
            fi
        else
            printf '\nSNAPPER_CONFIGS="root"\n' >> /etc/conf.d/snapper
        fi
    fi

    # /.snapshots exists as @snapshots mounted via fstab; tighten perms so
    # snapper's own validation is happy. Guarded against live/ISO envs where
    # /.snapshots may be a plain directory (no mount).
    if [[ -d /.snapshots ]]; then
        chmod 750 /.snapshots 2>/dev/null || true
        chown root:root /.snapshots 2>/dev/null || true
    fi
}

post_install() {
    systemctl daemon-reload || true
    systemctl enable shedos-pg-initdb.service || true
    systemctl enable shedos-firstboot-mirrors.service 2>/dev/null || true
    systemctl enable shedos-boot-success.service 2>/dev/null || true
    systemctl enable shedos-encrypt-enroll.service 2>/dev/null || true
    systemctl enable shedos-mount-report.service 2>/dev/null || true
    systemctl enable shedos-smart-check.timer 2>/dev/null || true
    /usr/lib/shedos/backfill-resume.py || true
    # Advance installs still on the previous default wallpaper.
    /usr/lib/shedos/backfill-default-wallpaper.py 2>/dev/null || true
    systemctl enable 'btrfs-scrub@-.timer' 2>/dev/null || true
    # Defense-in-depth VT wipe before greetd takes over tty1.
    systemctl enable shedos-clear-vt.service 2>/dev/null || true
    # One-shot heal for pre-rc4 installs whose locale/man/doc/info
    # files were stripped from the squashfs; no-op once the
    # /var/lib/shedos/locale-restore.done marker is in place.
    systemctl enable shedos-locale-restore.service 2>/dev/null || true
    # Creates a LOGIN+CREATEDB postgres role + same-named database for each
    # regular Linux user, on every boot (idempotent). Safety net for the
    # Calamares-time bootstrap in shedos_finalize; if that fails silently,
    # or if a new user is added post-install, this catches it.
    systemctl enable shedos-pg-user-bootstrap.service || true
    # AppArmor LSM: loads /etc/apparmor.d profiles once the lsm= cmdline
    # takes effect (next boot). The installer bakes lsm= into the
    # install-time cmdline, so a fresh install is enforcing from first boot.
    systemctl enable apparmor.service 2>/dev/null || true
    # --global enables the user-scope unit for every user on the system via
    # /etc/systemd/user/timers.target.wants/. Each user's systemd --user
    # instance picks it up on next login without any per-user bootstrap.
    systemctl --global enable shedos-update-check.timer || true
    systemctl --global enable shedos-check-health.timer || true
    systemctl --global enable shedos-doctor.timer || true
    systemctl --global enable shedos-claude-seed.service || true

    _add_shedos_repo
    _bootstrap_greetd
    _bootstrap_snapper
    _render_theme
    _apply_faillock_policy
    # State migrations run on fresh installs too — pre-cutover systems
    # were laid down by the archiso payload with legacy /etc values that
    # need the same correction the upgrade path applies. Order matches
    # post_upgrade: leaked-file strip first, then mkinitcpio HOOKS
    # (must precede anything that re-triggers mkinitcpio), then cmdline,
    # then locale.
    _strip_leaked_welcome_autostart
    _strip_leaked_installer_launcher
    _migrate_mkinitcpio_hooks
    _backfill_cmdline_ux_tokens
    # Lift the cmdline into /etc/kernel/cmdline for the signed-UKI boot path;
    # idempotent, no-op until a _uki preset is in place.
    /usr/lib/shedos/backfill-uki-cmdline.py || true
    _backfill_apparmor_lsm
    _backfill_luks_tries
    _fix_locale_conf_encoding
    _retire_legacy_kernel_setup

    # Timeline + cleanup timers from the snapper package. Idempotent enable:
    # re-running is harmless. Guarded against pacstrap (no running systemd)
    # and rootless containers.
    if [[ -d /run/systemd/system ]]; then
        systemctl enable --now snapper-timeline.timer 2>/dev/null || true
        systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
        systemctl enable --now systemd-oomd.service 2>/dev/null || true
        systemctl enable --now tlp.service 2>/dev/null || true
        systemctl enable --now ananicy-cpp.service 2>/dev/null || true
        systemctl enable --now shedos-reflector.timer 2>/dev/null || true
    else
        # In pacstrap / no-systemd contexts, fall back to enable-only so the
        # units come up on first real boot.
        systemctl enable snapper-timeline.timer 2>/dev/null || true
        systemctl enable snapper-cleanup.timer 2>/dev/null || true
        systemctl enable systemd-oomd.service 2>/dev/null || true
        systemctl enable tlp.service 2>/dev/null || true
        systemctl enable ananicy-cpp.service 2>/dev/null || true
        systemctl enable shedos-reflector.timer 2>/dev/null || true
    fi

    cat <<'EOF'

ShedOS system installed. Notes:
  * PostgreSQL cluster at /var/lib/postgres/data will be initialized on next
    boot if missing (via shedos-pg-initdb.service).
  * shedos-pg-user-bootstrap.service ensures each regular Linux user has a
    matching postgres role + database on every boot (idempotent).
  * shedos-update-check.timer is enabled system-wide; it starts automatically
    on your next user-session login. Click the waybar indicator to run
    `shedman update` interactively.
  * [shedos] repo added to /etc/pacman.conf — run `pacman -Sy` to refresh.
  * snapper is configured for / with a default pre/post policy; every
    `shedman update` run snapshots before and after. Roll back with
    `shedman update --rollback` or `shedman rollback`.
  * declarative system state lives at /etc/shedos/system.toml; run
    `shedman apply --dry-run` to preview how it maps to live state.
  * `shedman doctor` checks for drift every 6 hours (user timer) and pings
    mako + the waybar doctor pill when /etc/shedos/system.toml falls
    out of sync with reality. Run `shedman doctor --diff` any time.
  * All commands are discoverable via `shedman help`. Legacy `shedos-*`
    names still work via silent back-compat shims.
EOF
}

_backfill_cmdline_ux_tokens() {
    # Self-correcting backfill for the kernel cmdline UX tokens.
    #
    # Four classes of touched-up systems share this function:
    #
    #   (A) Installs predating commit 6f8a21a (2026-05-07): never had
    #       any UX tokens, suffer the boot/login console flash.
    #
    #   (B) Installs that ran the v1 backfill on commit a88274e
    #       (2026-05-08): got loglevel=3, rd.udev.log_level=3,
    #       console=tty1, AND fbcon=nodefer,map:99. console=tty1
    #       broke Plymouth's shutdown brand and (combined with
    #       fbcon=map:99) broke VT switching; v2 removed it.
    #
    #   (C) Installs that ran the v2 backfill: got loglevel=3,
    #       rd.udev.log_level=3, fbcon=nodefer,map:99. The map:99
    #       half permanently unmaps the framebuffer console from
    #       every VT, silently breaking Ctrl+Alt+F<N> TTY switching
    #       post-boot. Empirically confirmed: removing `,map:99`
    #       restored VT switching with no flash regression — the
    #       other mitigations (clear-vt-text.sh +
    #       quiet/loglevel=3/rd.udev.log_level=3 + journal
    #       redirects) cover flash suppression on their own.
    #
    #   (D) Post-v3 fresh installs: bootloader.py bakes in
    #       fbcon=nodefer (no map:99). v3 is a no-op for these.
    #
    # The corrective pass:
    #
    #   - REMOVE console=tty1 (left over from v1) and
    #     fbcon=nodefer,map:99 (left over from v1/v2) from every
    #     kernel_cmdline line that carries either.
    #   - ADD loglevel=3, rd.udev.log_level=3, fbcon=nodefer to
    #     every kernel_cmdline line that's missing any of them.
    #
    # We touch three places in order:
    #   1. /boot/limine.conf; every kernel_cmdline line (primary AND
    #      fallback). render-limine-config.sh strips only quiet/splash
    #      from fallback at generation time; every other token
    #      survives. So fresh post-fix installs carry the three UX
    #      tokens on their fallback entry too; we match that.
    #   2. Every existing ESP mirror of limine.conf; the firmware
    #      boots from the ESP, not /boot/limine.conf. Mirror set
    #      matches apply_core._ESP_LIMINE_MIRRORS.
    #   3. /var/lib/shedos/cmdline.baseline.json; add the three good
    #      tokens, remove console=tty1 and fbcon=nodefer,map:99 if
    #      either was stamped by v1 or v2. Atomic via tempfile +
    #      os.replace.
    #
    # Idempotent via /var/lib/shedos/.cmdline-ux-backfill-v3-applied.
    # The v3 sentinel is intentionally a different name so machines
    # that ran v1 (.cmdline-ux-backfill-applied) or v2
    # (.cmdline-ux-backfill-v2-applied) re-enter and get the
    # corrective pass.

    local sentinel=/var/lib/shedos/.cmdline-ux-backfill-v3-applied
    [[ -f $sentinel ]] && return 0

    local conf=/boot/limine.conf
    [[ -f $conf ]] || return 0

    # shellcheck disable=SC2054  # bash arrays split on whitespace, not commas; `fbcon=nodefer,map:99` is one element
    local add_tokens=(loglevel=3 rd.udev.log_level=3 fbcon=nodefer)
    # shellcheck disable=SC2054  # ditto for fbcon=nodefer,map:99 in the remove list
    local remove_tokens=(console=tty1 fbcon=nodefer,map:99)

    # Field-split match for "is <tok> a whole token on this line?".
    # Avoids gawk-only \<...\> word boundaries so the script works
    # under any POSIX awk (mawk, busybox-awk). Applies to every
    # kernel_cmdline line.
    local tmp
    tmp=$(mktemp)
    if ! awk \
        -v add="${add_tokens[*]}" \
        -v rem="${remove_tokens[*]}" '
        function has_token(line, tok,    fields, fcount, i) {
            fcount = split(line, fields, /[[:space:]]+/)
            for (i = 1; i <= fcount; i++) {
                if (fields[i] == tok) return 1
            }
            return 0
        }
        function strip_token(line, tok,    fields, fcount, i, out) {
            fcount = split(line, fields, /[[:space:]]+/)
            out = ""
            for (i = 1; i <= fcount; i++) {
                if (fields[i] != tok) {
                    out = (out == "" ? fields[i] : out " " fields[i])
                }
            }
            return out
        }
        /^[[:space:]]*kernel_cmdline:/ {
            line = $0
            # remove pass
            rcount = split(rem, r, " ")
            for (j = 1; j <= rcount; j++) {
                if (has_token(line, r[j])) {
                    line = strip_token(line, r[j])
                }
            }
            # add pass
            acount = split(add, a, " ")
            for (j = 1; j <= acount; j++) {
                if (!has_token(line, a[j])) {
                    line = line " " a[j]
                }
            }
            print line
            next
        }
        { print }
    ' "$conf" > "$tmp"; then
        rm -f "$tmp"
        echo "shedos-system: cmdline UX-token backfill skipped — awk failed on $conf" >&2
        return 0
    fi

    if cmp -s "$tmp" "$conf"; then
        # Already in good shape; just record the sentinel so we don't
        # re-run on every upgrade.
        rm -f "$tmp"
        mkdir -p "$(dirname "$sentinel")"
        : > "$sentinel"
        return 0
    fi

    install -Dm644 "$tmp" "$conf"
    rm -f "$tmp"
    echo "  → back-filled UX cmdline tokens into $conf"

    # Mirror to whichever ESP path Limine actually boots from. Set
    # matches apply_core._ESP_LIMINE_MIRRORS; keep in sync.
    local esp
    for esp in \
        /boot/efi/EFI/limine/limine.conf \
        /boot/efi/limine.conf \
        /efi/EFI/limine/limine.conf \
        /efi/limine.conf
    do
        [[ -f $esp ]] || continue
        install -Dm644 "$conf" "$esp" 2>/dev/null \
            && echo "  → mirrored to $esp"
    done

    # Sync the apply baseline: add the three good tokens if missing,
    # remove console=tty1 if v1 of this backfill stamped it in. Skip
    # cleanly if shedman apply has never run (no baseline) or python3
    # is missing. Atomic write via tempfile + os.replace mirrors
    # apply_core.save_state_set so a crash mid-write can't leave a
    # half-written baseline (which load_state_set would treat as
    # empty, triggering a strip on the next apply).
    #
    # Args to the embedded Python: <baseline-path> <add> <remove>,
    # newline-delimited — kernel tokens may contain commas
    # (console=ttyS0,115200), so CSV would shred them into fragments.
    local add_nl rem_nl
    add_nl=$(printf '%s\n' "${add_tokens[@]}")
    rem_nl=$(printf '%s\n' "${remove_tokens[@]}")
    local baseline=/var/lib/shedos/cmdline.baseline.json
    if [[ -f $baseline && -x /usr/bin/python3 ]]; then
        /usr/bin/python3 - "$baseline" "$add_nl" "$rem_nl" <<'PY' || true
import json
import os
import sys
import tempfile
from pathlib import Path

baseline_path = Path(sys.argv[1])
add_tokens = [t for t in sys.argv[2].split("\n") if t]
remove_tokens = [t for t in sys.argv[3].split("\n") if t]

doc = json.loads(baseline_path.read_text())
items = {tuple(item) for item in doc.get("items", [])}
changed = False
# Removals first: if a token appears in both lists, the add must win.
for tok in remove_tokens:
    if (tok,) in items:
        items.discard((tok,))
        changed = True
for tok in add_tokens:
    if (tok,) not in items:
        items.add((tok,))
        changed = True
if not changed:
    sys.exit(0)

doc["items"] = sorted([list(t) for t in items])
payload = json.dumps(doc, indent=2) + "\n"

fd, tmp = tempfile.mkstemp(
    dir=str(baseline_path.parent),
    prefix=".cmdline-backfill-",
)
try:
    with os.fdopen(fd, "w") as f:
        f.write(payload)
    os.chmod(tmp, 0o644)
    os.replace(tmp, baseline_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise

print(f"  -> updated cmdline baseline {baseline_path}")
PY
    fi

    mkdir -p "$(dirname "$sentinel")"
    : > "$sentinel"
}

_backfill_apparmor_lsm() {
    # Enable AppArmor on existing installs by adding the lsm= token to the
    # live Limine kernel cmdline. Fresh installs already carry it from the
    # installer's _build_cmdline; this backfills upgraders so AppArmor comes
    # on at the next reboot. lsm= is a full override of the kernel's LSM
    # list, so we only add ours when a line has no lsm= token already
    # (respecting a user who set their own). Idempotent via the sentinel.
    local sentinel=/var/lib/shedos/.apparmor-lsm-applied
    [[ -f $sentinel ]] && return 0

    local lsm_token="lsm=landlock,lockdown,yama,integrity,apparmor,bpf"
    local conf=/boot/limine.conf
    [[ -f $conf ]] || return 0

    local tmp
    tmp=$(mktemp)
    if ! awk -v tok="$lsm_token" '
        /^[[:space:]]*kernel_cmdline:/ {
            has_lsm = 0
            n = split($0, f, /[[:space:]]+/)
            for (i = 1; i <= n; i++) if (f[i] ~ /^lsm=/) has_lsm = 1
            if (!has_lsm) $0 = $0 " " tok
            print
            next
        }
        { print }
    ' "$conf" > "$tmp"; then
        rm -f "$tmp"
        echo "shedos-system: AppArmor lsm backfill skipped — awk failed on $conf" >&2
        return 0
    fi

    if ! cmp -s "$tmp" "$conf"; then
        install -Dm644 "$tmp" "$conf"
        echo "  → enabled AppArmor via lsm= in $conf"
        # Mirror to whichever ESP path Limine boots from. Set matches
        # apply_core._ESP_LIMINE_MIRRORS; keep in sync.
        local esp
        for esp in \
            /boot/efi/EFI/limine/limine.conf \
            /boot/efi/limine.conf \
            /efi/EFI/limine/limine.conf \
            /efi/limine.conf
        do
            [[ -f $esp ]] || continue
            install -Dm644 "$conf" "$esp" 2>/dev/null \
                && echo "  → mirrored to $esp"
        done
    fi
    rm -f "$tmp"

    # Add the lsm token to the apply baseline so `shedman apply` treats it
    # as protected and never strips it. Atomic write via tempfile +
    # os.replace, mirroring _backfill_cmdline_ux_tokens.
    local baseline=/var/lib/shedos/cmdline.baseline.json
    if [[ -f $baseline && -x /usr/bin/python3 ]]; then
        /usr/bin/python3 - "$baseline" "$lsm_token" <<'PY' || true
import json
import os
import sys
import tempfile
from pathlib import Path

baseline_path = Path(sys.argv[1])
tok = sys.argv[2]

doc = json.loads(baseline_path.read_text())
items = {tuple(item) for item in doc.get("items", [])}
if (tok,) in items:
    sys.exit(0)
items.add((tok,))
doc["items"] = sorted([list(t) for t in items])
payload = json.dumps(doc, indent=2) + "\n"

fd, tmp = tempfile.mkstemp(dir=str(baseline_path.parent), prefix=".apparmor-lsm-")
try:
    with os.fdopen(fd, "w") as f:
        f.write(payload)
    os.chmod(tmp, 0o644)
    os.replace(tmp, baseline_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
    fi

    mkdir -p "$(dirname "$sentinel")"
    : > "$sentinel"
}

_backfill_luks_tries() {
    # Existing encrypted installs that are already sd-encrypt (rd.luks.name in
    # the cmdline, from an FDE rc install) carry rd.luks.options=discard with no
    # tries= — so systemd-cryptsetup defaults to 3 attempts and then dead-ends
    # on a blank screen with no feedback. Fresh installs bake tries=0 in via the
    # installer, and the busybox->sd-encrypt migration adds it too; this is the
    # safety net for the boxes that are already sd-encrypt and pass through
    # neither path. tries=0 prompts forever. Gated on rd.luks.name so an
    # unencrypted system is a no-op. Idempotent via the sentinel.
    local sentinel=/var/lib/shedos/.luks-tries0-applied
    [[ -f $sentinel ]] && return 0

    local conf=/boot/limine.conf
    [[ -f $conf ]] || return 0

    # For every kernel_cmdline that unlocks a LUKS root, append ,tries=0 to an
    # existing rd.luks.options= value (via sub so the rest of the line and its
    # indentation survive) unless it already carries a tries= option, or add
    # rd.luks.options=tries=0 when rd.luks.name is present but rd.luks.options
    # is not.
    local tmp
    tmp=$(mktemp)
    if ! awk '
        /^[[:space:]]*kernel_cmdline:/ {
            line = $0
            n = split(line, f, /[[:space:]]+/)
            has_name = 0; has_opts = 0; opts_tries = 0
            for (i = 1; i <= n; i++) {
                if (f[i] ~ /^rd\.luks\.name=/) has_name = 1
                if (f[i] ~ /^rd\.luks\.options=/) {
                    has_opts = 1
                    if (f[i] ~ /[=,]tries=/) opts_tries = 1
                }
            }
            if (has_name && !opts_tries) {
                if (has_opts) {
                    sub(/rd\.luks\.options=[^[:space:]]*/, "&,tries=0", line)
                } else {
                    line = line " rd.luks.options=tries=0"
                }
            }
            print line
            next
        }
        { print }
    ' "$conf" > "$tmp"; then
        rm -f "$tmp"
        echo "shedos-system: LUKS tries=0 backfill skipped — awk failed on $conf" >&2
        return 0
    fi

    if ! cmp -s "$tmp" "$conf"; then
        install -Dm644 "$tmp" "$conf"
        echo "  → set rd.luks.options tries=0 (unlimited unlock retries) in $conf"
        # Mirror to whichever ESP path Limine boots from. Set matches
        # apply_core._ESP_LIMINE_MIRRORS; keep in sync.
        local esp
        for esp in \
            /boot/efi/EFI/limine/limine.conf \
            /boot/efi/limine.conf \
            /efi/EFI/limine/limine.conf \
            /efi/limine.conf
        do
            [[ -f $esp ]] || continue
            install -Dm644 "$conf" "$esp" 2>/dev/null \
                && echo "  → mirrored to $esp"
        done
    fi
    rm -f "$tmp"

    # Keep the apply baseline in step so `shedman apply` treats the tries=0
    # form as protected and never reverts it: apply the same transform to the
    # baseline's rd.luks.options token (or add one). Atomic via tempfile +
    # os.replace, mirroring _backfill_apparmor_lsm.
    local baseline=/var/lib/shedos/cmdline.baseline.json
    if [[ -f $baseline && -x /usr/bin/python3 ]]; then
        /usr/bin/python3 - "$baseline" <<'PY' || true
import json
import os
import re
import sys
import tempfile
from pathlib import Path

baseline_path = Path(sys.argv[1])
doc = json.loads(baseline_path.read_text())
items = [list(it) for it in doc.get("items", [])]

has_name = any(len(it) == 1 and it[0].startswith("rd.luks.name=") for it in items)
has_opts = False
changed = False
for it in items:
    if len(it) == 1 and it[0].startswith("rd.luks.options="):
        has_opts = True
        if not re.search(r"[=,]tries=", it[0]):
            it[0] = it[0] + ",tries=0"
            changed = True
if has_name and not has_opts:
    items.append(["rd.luks.options=tries=0"])
    changed = True
if not changed:
    sys.exit(0)

seen = set()
uniq = []
for it in items:
    key = tuple(it)
    if key not in seen:
        seen.add(key)
        uniq.append(it)
doc["items"] = sorted(uniq)
payload = json.dumps(doc, indent=2) + "\n"

fd, tmp = tempfile.mkstemp(dir=str(baseline_path.parent), prefix=".luks-tries0-")
try:
    with os.fdopen(fd, "w") as f:
        f.write(payload)
    os.chmod(tmp, 0o644)
    os.replace(tmp, baseline_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
    fi

    mkdir -p "$(dirname "$sentinel")"
    : > "$sentinel"
}

_fix_locale_conf_encoding() {
    # Calamares sometimes wrote /etc/locale.conf with bare locale names
    # (`LANG=en_NG`, `LC_TIME=en_NG`) instead of the encoding-qualified
    # form (`LANG=en_NG.UTF-8`). glibc indexes locales by their fully
    # qualified name; setlocale("en_NG") fails with "cannot change
    # locale" and bash prints the warning to stderr on every interactive
    # login. With greetd's session worker running bash on tty1, those
    # warnings reached tty1's vcs buffer and were painted by fbcon
    # during DRM-master gaps.
    #
    # Fresh installs done with the post-fix shedos_finalize Calamares
    # module no longer have this problem; this self-heal handles
    # existing installs from before that fix landed. Idempotent:
    # locale lines that already have a dot-separated encoding suffix
    # are left alone.
    local conf=/etc/locale.conf
    [[ -f $conf ]] || return 0
    [[ -x /usr/bin/python3 ]] || return 0

    /usr/bin/python3 - "$conf" <<'PY' 2>/dev/null
import sys
from pathlib import Path

p = Path(sys.argv[1])
original = p.read_text()
fixed = []
changed = False
for line in original.splitlines():
    stripped = line.strip()
    if "=" in stripped and not stripped.startswith("#"):
        key, _, value = stripped.partition("=")
        value = value.strip().strip('"').strip("'")
        if value and "." not in value and value not in ("C", "POSIX"):
            fixed.append(f"{key.strip()}={value}.UTF-8")
            changed = True
            continue
    fixed.append(line)
if changed:
    p.write_text("\n".join(fixed) + "\n")
    sys.exit(10)
PY
    # Exit code 10 from the Python heredoc means the file was rewritten.
    if [[ $? -eq 10 ]]; then
        echo "  → fixed bare locale names in $conf (added .UTF-8 suffix)"
    fi
}

_migrate_mkinitcpio_hooks() {
    # In-band call for the hotfix transaction itself; the
    # PreTransaction hook ships in this package and isn't on disk
    # yet when pacman scans hooks at transaction start.
    [[ -x /usr/lib/shedos/migrate-mkinitcpio-hooks.sh ]] || return 0
    /usr/lib/shedos/migrate-mkinitcpio-hooks.sh || true
}

_apply_faillock_policy() {
    # ShedOS lenient defaults: 6 tries / 5-min lockout (vs upstream 3 / 10-min).
    # Only rewrites the pristine upstream commented defaults; any user
    # customization (commented or uncommented, different value) is left alone.
    local f=/etc/security/faillock.conf
    [[ -f $f ]] || return 0
    sed -i -E \
        -e 's/^[[:space:]]*#[[:space:]]*deny[[:space:]]*=[[:space:]]*3[[:space:]]*$/deny = 6/' \
        -e 's/^[[:space:]]*#[[:space:]]*unlock_time[[:space:]]*=[[:space:]]*600[[:space:]]*$/unlock_time = 300/' \
        "$f"
}

_strip_leaked_welcome_autostart() {
    # Existing installs carry the autostart entry + per-user marker
    # from when the live ISO airootfs shipped them; without removal
    # the autostart logs "exec /usr/bin/shedos-welcome not found" on
    # every login now that the yad welcome surface is gone.
    rm -f /etc/xdg/autostart/shedos-welcome.desktop 2>/dev/null || true
    local home
    while IFS=: read -r _ _ _ _ _ home _; do
        [[ "$home" == /home/* ]] || continue
        rm -f "$home/.config/shedos-setup-complete" 2>/dev/null || true
    done < <(getent passwd 2>/dev/null)
}

_strip_leaked_installer_launcher() {
    rm -f /usr/share/applications/shedos-install.desktop 2>/dev/null || true
}

_retire_legacy_kernel_setup() {
    # Part of the shedos-kernel -> linux-zen migration. shedos-kernel is
    # intentionally kept installed through this upgrade so the box always
    # has a known-good, already-booting kernel; the shedos-retire-kernel
    # one-shot removes it on the first boot that lands on linux-zen, so a
    # bad linux-zen can never strand the user. Here we only arm that
    # one-shot and make linux-zen the default boot entry so that first
    # boot actually lands on it. No-op on fresh installs (no shedos-kernel).
    pacman -Qq shedos-kernel &>/dev/null || return 0

    # If the saved default still names the kernel we're retiring, repoint
    # it at linux-zen — otherwise render-limine-config.sh would keep
    # booting shedos-kernel and the one-shot would never fire.
    local default_file=/var/lib/shedos/kernel-default
    if [[ -f $default_file && "$(cat "$default_file" 2>/dev/null)" == shedos-kernel ]]; then
        echo linux-zen > "$default_file"
    fi

    systemctl enable shedos-retire-kernel.service 2>/dev/null || true
}

post_upgrade() {
    systemctl daemon-reload || true
    systemctl enable shedos-pg-user-bootstrap.service || true
    systemctl enable shedos-firstboot-mirrors.service 2>/dev/null || true
    systemctl enable shedos-boot-success.service 2>/dev/null || true
    systemctl enable shedos-encrypt-enroll.service 2>/dev/null || true
    systemctl enable shedos-mount-report.service 2>/dev/null || true
    systemctl enable shedos-smart-check.timer 2>/dev/null || true
    systemctl enable 'btrfs-scrub@-.timer' 2>/dev/null || true
    # Hibernation retrofit for machines with disk swap; idempotent.
    /usr/lib/shedos/backfill-resume.py || true
    # Advance installs still on the previous default wallpaper.
    /usr/lib/shedos/backfill-default-wallpaper.py 2>/dev/null || true
    # Defense-in-depth VT wipe before greetd takes over tty1.
    systemctl enable shedos-clear-vt.service 2>/dev/null || true
    # One-shot heal for pre-rc4 installs whose locale/man/doc/info
    # files were stripped from the squashfs; no-op once the
    # /var/lib/shedos/locale-restore.done marker is in place.
    systemctl enable shedos-locale-restore.service 2>/dev/null || true
    # AppArmor LSM: enable so profiles load once the backfilled lsm=
    # cmdline takes effect on the next reboot.
    systemctl enable apparmor.service 2>/dev/null || true
    systemctl --global enable shedos-update-check.timer || true
    systemctl --global enable shedos-check-health.timer || true
    systemctl --global enable shedos-doctor.timer || true
    systemctl --global enable shedos-claude-seed.service || true

    _migrate_repo_url
    _add_shedos_repo
    _bootstrap_greetd
    _bootstrap_snapper
    _render_theme
    _apply_faillock_policy
    _strip_leaked_welcome_autostart
    _strip_leaked_installer_launcher
    # Must precede anything that could re-trigger mkinitcpio.
    _migrate_mkinitcpio_hooks
    _backfill_cmdline_ux_tokens
    # Lift the cmdline into /etc/kernel/cmdline for the signed-UKI boot path;
    # idempotent, no-op until a _uki preset is in place.
    /usr/lib/shedos/backfill-uki-cmdline.py || true
    _backfill_apparmor_lsm
    _backfill_luks_tries
    _fix_locale_conf_encoding
    _retire_legacy_kernel_setup

    if [[ -d /run/systemd/system ]]; then
        systemctl enable --now snapper-timeline.timer 2>/dev/null || true
        systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
        systemctl enable --now systemd-oomd.service 2>/dev/null || true
        systemctl enable --now tlp.service 2>/dev/null || true
        systemctl enable --now ananicy-cpp.service 2>/dev/null || true
        systemctl enable --now shedos-reflector.timer 2>/dev/null || true
    fi
}

pre_remove() {
    systemctl disable --now shedos-pg-initdb.service 2>/dev/null || true
    systemctl disable --now shedos-pg-user-bootstrap.service 2>/dev/null || true

    _remove_shedos_repo
}

post_remove() {
    systemctl daemon-reload || true
}
