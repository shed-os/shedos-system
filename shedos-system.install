# shedos-system install scriptlet
#
# Runs as root in the target install root. For a normal `pacman -S` this is
# the live system; during pacstrap it's the install target.

_add_shedos_repo() {
    # Skip when running inside the ShedOS package-build chroot. The build
    # script (scripts/build-shedos-packages.sh) creates this marker so the
    # scriptlet doesn't add the production repo to the build container's
    # /etc/pacman.conf — the next pacman -Sy inside makepkg would 404 on
    # a repo whose db doesn't yet exist (we're building what would land
    # there). Pacstrap and Calamares chroot into a target rootfs, so the
    # marker at container / isn't visible to them; they get normal behavior.
    [[ -e /.shedos-build-environment ]] && return 0

    # /etc/pacman.conf is owned by `pacman`. We append a fenced block.
    # The strip-then-append flow is idempotent AND handles bare [shedos]
    # blocks left behind by older airootfs templates (rc16 and earlier
    # baked one in, which collided with this hook's marker-fenced append
    # and produced `database already registered` from pacman -Sy).
    local pacman_conf=/etc/pacman.conf
    [[ -f $pacman_conf ]] || return 0
    local tmp
    tmp=$(mktemp)

    # Drop every existing [shedos] block — fenced or bare — so we end
    # up with at most one canonical block after appending below.
    awk '
        /^# >>> shedos <<<$/                  { skip=1; next }
        /^# <<< shedos >>>$/                  { skip=0; next }
        /^\[shedos\][[:space:]]*$/            { skip=2; next }
        skip==2 && (/^\[/ || /^[[:space:]]*$/) { skip=0 }
        !skip                                 { print }
    ' "$pacman_conf" > "$tmp"

    cat >> "$tmp" <<'EOF'

# >>> shedos <<<
# Managed by shedos-system — do not edit between these markers.
# Run `pacman -R shedos-system` to remove automatically.
[shedos]
SigLevel = Required DatabaseRequired
Server = https://repo.shedos.org/stable/$arch
# <<< shedos >>>
EOF
    install -Dm644 "$tmp" "$pacman_conf"
    rm -f "$tmp"

    # Also append a *commented-out* [shedos-testing] block so users who
    # want to opt into the canary channel can do so by uncommenting,
    # without having to remember the URL or SigLevel.
    if ! grep -q '^# >>> shedos-testing <<<' "$pacman_conf"; then
        cat >>"$pacman_conf" <<'EOF'

# >>> shedos-testing <<<
# ShedOS canary channel — RC packages land here before reaching
# [shedos]. Uncomment the four lines below to opt in. Stable cuts
# also publish to /test/x86_64/, so opting in only changes
# behavior during RC windows.
#[shedos-testing]
#SigLevel = Required DatabaseRequired
#Server = https://repo.shedos.org/test/$arch
# <<< shedos-testing >>>
EOF
    fi
}

_migrate_repo_url() {
    sed -i \
        -e '/^# >>> shedos <<<$/,/^# <<< shedos >>>$/ s|^Server = https://repo\.shedos\.org/\$arch$|Server = https://repo.shedos.org/stable/$arch|' \
        -e '/^# >>> shedos-testing <<<$/,/^# <<< shedos-testing >>>$/ s|^#Server = https://repo\.shedos\.org/\$arch-testing$|#Server = https://repo.shedos.org/test/$arch|' \
        -e '/^# >>> shedos-testing <<<$/,/^# <<< shedos-testing >>>$/ s|/x86_64-testing/|/test/x86_64/|' \
        /etc/pacman.conf
}

_remove_shedos_repo() {
    # Strip the fenced block(s) on uninstall. sed operates on exact marker
    # ranges so a user who scribbles outside the blocks keeps their edits.
    # May leave a trailing blank line in /etc/pacman.conf — cosmetic only.
    if grep -q '^# >>> shedos <<<' /etc/pacman.conf; then
        sed -i '/^# >>> shedos <<<$/,/^# <<< shedos >>>$/d' /etc/pacman.conf
    fi
    if grep -q '^# >>> shedos-testing <<<' /etc/pacman.conf; then
        sed -i '/^# >>> shedos-testing <<<$/,/^# <<< shedos-testing >>>$/d' /etc/pacman.conf
    fi
}

_render_theme() {
    # Rebuild /etc/shedos/themes/current/ from system.toml [theme] +
    # the named palette. Best-effort: a missing python3 or theme module
    # just leaves the previous render in place.
    if [[ -x /usr/bin/python3 && -f /usr/lib/shedos/theme_renderer.py ]]; then
        /usr/bin/python3 /usr/lib/shedos/theme_renderer.py >/dev/null 2>&1 || true
    fi
}

_bootstrap_greetd() {
    # /etc/greetd/config.toml is shipped by the greetd package, so we
    # can't ship our own at that path (pacman file conflict). Template
    # lives under /usr/share/shedos/greetd/ and we copy it into place
    # on every install + upgrade so a stray .pacnew from an upstream
    # greetd update doesn't drift our defaults.
    local src=/usr/share/shedos/greetd/config.toml
    local dst=/etc/greetd/config.toml
    if [[ -f $src ]]; then
        install -Dm644 "$src" "$dst"
    fi

    local pam_src=/usr/share/shedos/greetd/greetd.pam
    local pam_dst=/etc/pam.d/greetd
    if [[ -f $pam_src ]]; then
        install -Dm644 "$pam_src" "$pam_dst"
    fi

    # The `greeter` system user (created by greetd's sysusers.d) needs:
    #   - `seat`  — talk to seatd, acquire a Wayland seat for cage
    #   - `video` — open /dev/dri/cardX for EGL/GBM
    #   - `input` — read /dev/input/event* for keyboard/touchpad
    # Without these the cage compositor fails with EGL_BAD_ALLOC and
    # libseat connect errors during boot.
    # `groupadd -r -f` ensures the groups exist before usermod runs;
    # seatd's sysusers.d may install the seat group AFTER shedos-system
    # in some pacman orderings, leaving usermod silently failing with
    # "group seat does not exist" and the greeter unable to acquire seat0.
    groupadd -r -f seat
    groupadd -r -f input
    groupadd -r -f video
    if id greeter &>/dev/null; then
        usermod -aG seat,video,input greeter 2>/dev/null || true
    fi

    # Mask getty@tty1.service and its autovt@tty1 alias so no agetty
    # ever spawns on tty1. greetd's [terminal] vt = 1 pins greetd
    # there exclusively; without the mask, getty@tty1 still runs
    # briefly at boot (despite Conflicts=greetd), prints its banner
    # + bash setlocale warnings to /dev/tty1 → vcs1, and that text
    # is painted by fbcon during DRM-master gaps at compositor
    # handoffs. Skip during pacstrap (no running systemd).
    if [[ -d /run/systemd/system ]]; then
        systemctl mask getty@tty1.service 2>/dev/null || true
        systemctl mask autovt@tty1.service 2>/dev/null || true
    fi
}

_bootstrap_snapper() {
    # Install the default snapper config for `/` on first install only. A
    # subsequent upgrade finds /etc/snapper/configs/root already present and
    # leaves it alone so user tuning sticks (retention limits, timeline
    # cadence, etc.). The template lives under /usr/share/shedos/snapper/
    # so we don't collide with the snapper package's ownership of
    # /etc/snapper/configs/.
    local tpl=/usr/share/shedos/snapper/root.conf
    local dst=/etc/snapper/configs/root
    [[ -f $tpl ]] || return 0

    if [[ ! -f $dst ]]; then
        install -Dm640 "$tpl" "$dst"
        chown root:root "$dst"
    fi

    # Point snapper at the root config. /etc/conf.d/snapper is shipped by
    # the snapper package with SNAPPER_CONFIGS="" by default.
    if [[ -f /etc/conf.d/snapper ]]; then
        if grep -q '^SNAPPER_CONFIGS=' /etc/conf.d/snapper; then
            # Merge 'root' into any existing list, preserving other entries.
            if ! grep -qE '^SNAPPER_CONFIGS="[^"]*\broot\b' /etc/conf.d/snapper; then
                sed -i -E \
                    's/^SNAPPER_CONFIGS="([^"]*)"/SNAPPER_CONFIGS="\1 root"/' \
                    /etc/conf.d/snapper
                # Squash leading space if the previous list was empty.
                sed -i -E 's/^SNAPPER_CONFIGS=" /SNAPPER_CONFIGS="/' \
                    /etc/conf.d/snapper
            fi
        else
            printf '\nSNAPPER_CONFIGS="root"\n' >> /etc/conf.d/snapper
        fi
    fi

    # /.snapshots exists as @snapshots mounted via fstab — tighten perms so
    # snapper's own validation is happy. Guarded against live/ISO envs where
    # /.snapshots may be a plain directory (no mount).
    if [[ -d /.snapshots ]]; then
        chmod 750 /.snapshots 2>/dev/null || true
        chown root:root /.snapshots 2>/dev/null || true
    fi
}

post_install() {
    systemctl daemon-reload || true
    systemctl enable shedos-pg-initdb.service || true
    # Defense-in-depth VT wipe before greetd takes over tty1.
    systemctl enable shedos-clear-vt.service 2>/dev/null || true
    # Creates a LOGIN+CREATEDB postgres role + same-named database for each
    # regular Linux user, on every boot (idempotent). Safety net for the
    # Calamares-time bootstrap in shedos_finalize — if that fails silently,
    # or if a new user is added post-install, this catches it.
    systemctl enable shedos-pg-user-bootstrap.service || true
    # --global enables the user-scope unit for every user on the system via
    # /etc/systemd/user/timers.target.wants/. Each user's systemd --user
    # instance picks it up on next login without any per-user bootstrap.
    systemctl --global enable shedos-update-check.timer || true
    systemctl --global enable shedos-check-health.timer || true
    systemctl --global enable shedos-doctor.timer || true

    _add_shedos_repo
    _bootstrap_greetd
    _bootstrap_snapper
    _render_theme

    # Timeline + cleanup timers from the snapper package. Idempotent enable:
    # re-running is harmless. Guarded against pacstrap (no running systemd)
    # and rootless containers.
    if [[ -d /run/systemd/system ]]; then
        systemctl enable --now snapper-timeline.timer 2>/dev/null || true
        systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
        systemctl enable --now systemd-oomd.service 2>/dev/null || true
        systemctl enable --now tlp.service 2>/dev/null || true
        systemctl enable --now ananicy-cpp.service 2>/dev/null || true
        systemctl enable --now shedos-reflector.timer 2>/dev/null || true
    else
        # In pacstrap / no-systemd contexts, fall back to enable-only so the
        # units come up on first real boot.
        systemctl enable snapper-timeline.timer 2>/dev/null || true
        systemctl enable snapper-cleanup.timer 2>/dev/null || true
        systemctl enable systemd-oomd.service 2>/dev/null || true
        systemctl enable tlp.service 2>/dev/null || true
        systemctl enable ananicy-cpp.service 2>/dev/null || true
        systemctl enable shedos-reflector.timer 2>/dev/null || true
    fi

    cat <<'EOF'

ShedOS system installed. Notes:
  * PostgreSQL cluster at /var/lib/postgres/data will be initialized on next
    boot if missing (via shedos-pg-initdb.service).
  * shedos-pg-user-bootstrap.service ensures each regular Linux user has a
    matching postgres role + database on every boot (idempotent).
  * shedos-update-check.timer is enabled system-wide; it starts automatically
    on your next user-session login. Click the waybar indicator to run
    `shedman update` interactively.
  * [shedos] repo added to /etc/pacman.conf — run `pacman -Sy` to refresh.
  * snapper is configured for / with a default pre/post policy; every
    `shedman update` run snapshots before and after. Roll back with
    `shedman update --rollback` or `shedman rollback`.
  * declarative system state lives at /etc/shedos/system.toml; run
    `shedman apply --dry-run` to preview how it maps to live state.
  * `shedman doctor` checks for drift every 6 hours (user timer) and pings
    mako + the waybar doctor pill when /etc/shedos/system.toml falls
    out of sync with reality. Run `shedman doctor --diff` any time.
  * All commands are discoverable via `shedman help`. Legacy `shedos-*`
    names still work via silent back-compat shims.
EOF
}

_backfill_cmdline_ux_tokens() {
    # Self-correcting backfill for the kernel cmdline UX tokens.
    #
    # Two classes of touched-up systems share this function:
    #
    #   (A) Installs predating commit 6f8a21a (2026-05-07): never had
    #       any UX tokens, suffer the boot/login console flash.
    #
    #   (B) Installs that already ran the v1 backfill on commit
    #       a88274e (2026-05-08): got loglevel=3, rd.udev.log_level=3,
    #       console=tty1, AND fbcon=nodefer,map:99 — but `console=tty1`
    #       broke Plymouth's shutdown brand (Plymouth interprets any
    #       explicit `console=` as a serial console and force-falls
    #       back to the text-only `details` plugin) and also broke VT
    #       switching because of how fbcon=map:99 + console=tty1
    #       interact.
    #
    # The corrective pass:
    #
    #   - REMOVE console=tty1 from every kernel_cmdline line that
    #     carries it (the v1 backfill stamped it on both primary and
    #     fallback).
    #   - ADD loglevel=3, rd.udev.log_level=3, fbcon=nodefer,map:99 to
    #     every kernel_cmdline line that's missing any of them.
    #
    # We touch three places in order:
    #   1. /boot/limine.conf — every kernel_cmdline line (primary AND
    #      fallback). render-limine-config.sh strips only quiet/splash
    #      from fallback at generation time; every other token
    #      survives. So fresh post-fix installs carry the three UX
    #      tokens on their fallback entry too — we match that.
    #   2. Every existing ESP mirror of limine.conf — the firmware
    #      boots from the ESP, not /boot/limine.conf. Mirror set
    #      matches apply_core._ESP_LIMINE_MIRRORS.
    #   3. /var/lib/shedos/cmdline.baseline.json — add the three good
    #      tokens, remove console=tty1 if it was added by v1. Atomic
    #      via tempfile + os.replace.
    #
    # Idempotent via /var/lib/shedos/.cmdline-ux-backfill-v2-applied.
    # The v2 sentinel is intentionally a different name so machines
    # that ran v1 (sentinel /var/lib/shedos/.cmdline-ux-backfill-
    # applied) re-enter and get the corrective pass.

    local sentinel=/var/lib/shedos/.cmdline-ux-backfill-v2-applied
    [[ -f $sentinel ]] && return 0

    local conf=/boot/limine.conf
    [[ -f $conf ]] || return 0

    # shellcheck disable=SC2054  # bash arrays split on whitespace, not commas — `fbcon=nodefer,map:99` is one element
    local add_tokens=(loglevel=3 rd.udev.log_level=3 fbcon=nodefer,map:99)
    local remove_tokens=(console=tty1)

    # Field-split match for "is <tok> a whole token on this line?".
    # Avoids gawk-only \<...\> word boundaries so the script works
    # under any POSIX awk (mawk, busybox-awk). Applies to every
    # kernel_cmdline line.
    local tmp
    tmp=$(mktemp)
    if ! awk \
        -v add="${add_tokens[*]}" \
        -v rem="${remove_tokens[*]}" '
        function has_token(line, tok,    fields, fcount, i) {
            fcount = split(line, fields, /[[:space:]]+/)
            for (i = 1; i <= fcount; i++) {
                if (fields[i] == tok) return 1
            }
            return 0
        }
        function strip_token(line, tok,    fields, fcount, i, out) {
            fcount = split(line, fields, /[[:space:]]+/)
            out = ""
            for (i = 1; i <= fcount; i++) {
                if (fields[i] != tok) {
                    out = (out == "" ? fields[i] : out " " fields[i])
                }
            }
            return out
        }
        /^[[:space:]]*kernel_cmdline:/ {
            line = $0
            # remove pass
            rcount = split(rem, r, " ")
            for (j = 1; j <= rcount; j++) {
                if (has_token(line, r[j])) {
                    line = strip_token(line, r[j])
                }
            }
            # add pass
            acount = split(add, a, " ")
            for (j = 1; j <= acount; j++) {
                if (!has_token(line, a[j])) {
                    line = line " " a[j]
                }
            }
            print line
            next
        }
        { print }
    ' "$conf" > "$tmp"; then
        rm -f "$tmp"
        echo "shedos-system: cmdline UX-token backfill skipped — awk failed on $conf" >&2
        return 0
    fi

    if cmp -s "$tmp" "$conf"; then
        # Already in good shape — just record the sentinel so we don't
        # re-run on every upgrade.
        rm -f "$tmp"
        mkdir -p "$(dirname "$sentinel")"
        : > "$sentinel"
        return 0
    fi

    install -Dm644 "$tmp" "$conf"
    rm -f "$tmp"
    echo "  → back-filled UX cmdline tokens into $conf"

    # Mirror to whichever ESP path Limine actually boots from. Set
    # matches apply_core._ESP_LIMINE_MIRRORS — keep in sync.
    local esp
    for esp in \
        /boot/efi/EFI/limine/limine.conf \
        /boot/efi/limine.conf \
        /efi/EFI/limine/limine.conf \
        /efi/limine.conf
    do
        [[ -f $esp ]] || continue
        install -Dm644 "$conf" "$esp" 2>/dev/null \
            && echo "  → mirrored to $esp"
    done

    # Sync the apply baseline: add the three good tokens if missing,
    # remove console=tty1 if v1 of this backfill stamped it in. Skip
    # cleanly if shedman apply has never run (no baseline) or python3
    # is missing. Atomic write via tempfile + os.replace mirrors
    # apply_core.save_state_set so a crash mid-write can't leave a
    # half-written baseline (which load_state_set would treat as
    # empty, triggering a strip on the next apply).
    #
    # Args to the embedded Python: <baseline-path> <add-csv> <remove-csv>
    local add_csv rem_csv
    add_csv=$(IFS=,; echo "${add_tokens[*]}")
    rem_csv=$(IFS=,; echo "${remove_tokens[*]}")
    local baseline=/var/lib/shedos/cmdline.baseline.json
    if [[ -f $baseline && -x /usr/bin/python3 ]]; then
        /usr/bin/python3 - "$baseline" "$add_csv" "$rem_csv" <<'PY' || true
import json
import os
import sys
import tempfile
from pathlib import Path

baseline_path = Path(sys.argv[1])
add_tokens = [t for t in sys.argv[2].split(",") if t]
remove_tokens = [t for t in sys.argv[3].split(",") if t]

doc = json.loads(baseline_path.read_text())
items = {tuple(item) for item in doc.get("items", [])}
changed = False
for tok in add_tokens:
    if (tok,) not in items:
        items.add((tok,))
        changed = True
for tok in remove_tokens:
    if (tok,) in items:
        items.discard((tok,))
        changed = True
if not changed:
    sys.exit(0)

doc["items"] = sorted([list(t) for t in items])
payload = json.dumps(doc, indent=2) + "\n"

fd, tmp = tempfile.mkstemp(
    dir=str(baseline_path.parent),
    prefix=".cmdline-backfill-",
)
try:
    with os.fdopen(fd, "w") as f:
        f.write(payload)
    os.chmod(tmp, 0o644)
    os.replace(tmp, baseline_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise

print(f"  -> updated cmdline baseline {baseline_path}")
PY
    fi

    mkdir -p "$(dirname "$sentinel")"
    : > "$sentinel"
}

_fix_locale_conf_encoding() {
    # Calamares sometimes wrote /etc/locale.conf with bare locale names
    # (`LANG=en_NG`, `LC_TIME=en_NG`) instead of the encoding-qualified
    # form (`LANG=en_NG.UTF-8`). glibc indexes locales by their fully
    # qualified name; setlocale("en_NG") fails with "cannot change
    # locale" and bash prints the warning to stderr on every interactive
    # login. With greetd's session worker running bash on tty1, those
    # warnings reached tty1's vcs buffer and were painted by fbcon
    # during DRM-master gaps.
    #
    # Fresh installs done with the post-fix shedos_finalize Calamares
    # module no longer have this problem; this self-heal handles
    # existing installs from before that fix landed. Idempotent:
    # locale lines that already have a dot-separated encoding suffix
    # are left alone.
    local conf=/etc/locale.conf
    [[ -f $conf ]] || return 0
    [[ -x /usr/bin/python3 ]] || return 0

    /usr/bin/python3 - "$conf" <<'PY' 2>/dev/null
import sys
from pathlib import Path

p = Path(sys.argv[1])
original = p.read_text()
fixed = []
changed = False
for line in original.splitlines():
    stripped = line.strip()
    if "=" in stripped and not stripped.startswith("#"):
        key, _, value = stripped.partition("=")
        value = value.strip().strip('"').strip("'")
        if value and "." not in value and value not in ("C", "POSIX"):
            fixed.append(f"{key.strip()}={value}.UTF-8")
            changed = True
            continue
    fixed.append(line)
if changed:
    p.write_text("\n".join(fixed) + "\n")
    sys.exit(10)
PY
    # Exit code 10 from the Python heredoc means the file was rewritten.
    if [[ $? -eq 10 ]]; then
        echo "  → fixed bare locale names in $conf (added .UTF-8 suffix)"
    fi
}

_self_heal_welcome_marker() {
    # One-shot fix for users stuck behind the old (rc1) silent-marker
    # bug: marker present AND ~/.gitconfig lacks user.email is the
    # fingerprint of a welcome that never actually showed.
    local user uid home marker gitconfig
    while IFS=: read -r user _ uid _ _ home _; do
        [[ "$uid" -ge 1000 ]] || continue
        [[ "$home" == /home/* ]] || continue
        [[ -d "$home" ]] || continue
        marker="$home/.config/shedos-setup-complete"
        gitconfig="$home/.gitconfig"
        [[ -f "$marker" ]] || continue
        if [[ -f "$gitconfig" ]] && \
           grep -qE '^\s*email\s*=' "$gitconfig" 2>/dev/null; then
            continue
        fi
        rm -f "$marker"
        echo "  → cleared stale welcome marker for $user (no user.email in ~/.gitconfig)"
    done < <(getent passwd 2>/dev/null)
}

post_upgrade() {
    systemctl daemon-reload || true
    systemctl enable shedos-pg-user-bootstrap.service || true
    # Defense-in-depth VT wipe before greetd takes over tty1.
    systemctl enable shedos-clear-vt.service 2>/dev/null || true
    systemctl --global enable shedos-update-check.timer || true
    systemctl --global enable shedos-check-health.timer || true
    systemctl --global enable shedos-doctor.timer || true

    _migrate_repo_url
    _add_shedos_repo
    _bootstrap_greetd
    _bootstrap_snapper
    _render_theme
    _self_heal_welcome_marker
    _backfill_cmdline_ux_tokens
    _fix_locale_conf_encoding

    if [[ -d /run/systemd/system ]]; then
        systemctl enable --now snapper-timeline.timer 2>/dev/null || true
        systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
        systemctl enable --now systemd-oomd.service 2>/dev/null || true
        systemctl enable --now tlp.service 2>/dev/null || true
        systemctl enable --now ananicy-cpp.service 2>/dev/null || true
        systemctl enable --now shedos-reflector.timer 2>/dev/null || true
    fi
}

pre_remove() {
    systemctl disable --now shedos-pg-initdb.service 2>/dev/null || true
    systemctl disable --now shedos-pg-user-bootstrap.service 2>/dev/null || true

    _remove_shedos_repo
}

post_remove() {
    systemctl daemon-reload || true
}
