#!/bin/bash
# First-boot wizard. Collects name/email/github, writes them to
# ~/.gitconfig. The marker only gets written on confirmed user
# interaction; yad-launch failures leave it off so next login retries.

set -u

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shedos"
LOG="$LOG_DIR/welcome.log"
MARKER_FILE="$HOME/.config/shedos-setup-complete"

log() {
    mkdir -p "$LOG_DIR" 2>/dev/null || return 0
    printf '%s [%d] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$*" \
        >> "$LOG" 2>/dev/null || true
}

notify_user_yad_missing() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -i preferences-system \
            "ShedOS welcome" \
            "yad is not installed; the first-boot wizard can't run. Install yad and log in again." \
            >/dev/null 2>&1 || true
    fi
}

# ── Argument handling ───────────────────────────────────────────────
FORCE=0
for arg in "$@"; do
    case "$arg" in
        --help-summary)
            echo "first-boot developer setup wizard"
            exit 0
            ;;
        --help|-h)
            cat <<'EOF'
Usage: shedman welcome [--force]

First-boot developer setup wizard. Collects full name, email, and an
optional GitHub username, then writes them to ~/.gitconfig.

  -f, --force, --redo   Re-run the wizard even if the completion marker
                        already exists. Removes the marker first.
  -h, --help            Show this message.

Files:
  ~/.config/shedos-setup-complete   marker; presence skips the wizard
  ~/.local/state/shedos/welcome.log diagnostic log (append-only)
EOF
            exit 0
            ;;
        --force|-f|--redo)
            FORCE=1
            ;;
        *)
            echo "shedman welcome: unknown argument: $arg" >&2
            echo "Try 'shedman welcome --help'." >&2
            exit 2
            ;;
    esac
done

# Skip in the live ISO and during Calamares.
if [[ -f /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux ]] || \
   [[ -d /run/archiso ]] || \
   { [[ "${USER:-}" == "shedos" ]] && [[ -f /etc/calamares/settings.conf ]]; }; then
    log "skip: running inside live ISO / calamares"
    exit 0
fi

if [[ $FORCE -eq 1 ]]; then
    log "--force: removing marker $MARKER_FILE"
    rm -f "$MARKER_FILE"
fi

if [[ -f "$MARKER_FILE" ]]; then
    log "skip: marker already present"
    exit 0
fi

# `2>>"$LOG"` below would fail if LOG_DIR doesn't exist yet; make it first.
mkdir -p "$LOG_DIR" 2>/dev/null || true

if ! mkdir -p "$HOME/.config" 2>>"$LOG"; then
    log "error: cannot create \$HOME/.config — bailing without marker"
    exit 0
fi

if ! command -v yad >/dev/null 2>&1; then
    log "yad not installed — exiting without marker; next login will retry"
    notify_user_yad_missing
    exit 0
fi

FULL_NAME=$(getent passwd "$USER" 2>/dev/null | cut -d: -f5 | cut -d, -f1)
[[ -z "$FULL_NAME" ]] && FULL_NAME="$USER"

EXISTING_EMAIL=""
if command -v git >/dev/null 2>&1; then
    EXISTING_EMAIL=$(git config --global --get user.email 2>/dev/null || true)
fi

log "launching yad form (name=$FULL_NAME existing_email=$EXISTING_EMAIL)"

# Loop the form until either the user clicks Skip / closes the dialog,
# or they submit valid data. Earlier versions exec'd $0 on validation
# failure, which spawned a second welcome window; avoid that.
NAME="$FULL_NAME"
EMAIL="$EXISTING_EMAIL"
GITHUB=""
while true; do
    RESULT=$(yad --form \
        --title="Welcome to ShedOS" \
        --width=400 \
        --center \
        --window-icon=preferences-system \
        --image=preferences-desktop-personal \
        --field="Welcome to ShedOS\!:LBL" "" \
        --field="Let's set up your development environment.:LBL" "" \
        --field="This information will be used to configure git.:LBL" "" \
        --field="Full Name:":TEXT "$NAME" \
        --field="Email Address:":TEXT "$EMAIL" \
        --field="GitHub Username (optional):":TEXT "$GITHUB" \
        --field=":LBL" "" \
        --field="You can change these settings later with 'git config':LBL" "" \
        --button="Skip:1" \
        --button="Configure:0" \
        2>>"$LOG")
    EXIT_CODE=$?

    log "yad form exit_code=$EXIT_CODE"

    case "$EXIT_CODE" in
        0)
            ;;
        1)
            log "user clicked Skip — marker set"
            touch "$MARKER_FILE" 2>>"$LOG" || true
            exit 0
            ;;
        *)
            log "yad failed (exit $EXIT_CODE) — exiting without marker; next login will retry"
            notify_user_yad_missing
            exit 0
            ;;
    esac

    # Fields are |-separated; LBL fields are empty strings we have to consume.
    IFS='|' read -r _ _ _ NAME EMAIL GITHUB _ <<< "$RESULT"

    if [[ -n "$EMAIL" && "$EMAIL" =~ "@" ]]; then
        break
    fi

    log "invalid email entered: ${EMAIL@Q} — re-prompting"
    yad --error \
        --title="Invalid Email" \
        --text="Please enter a valid email address." \
        --width=300 \
        --center \
        --button="OK!gtk-ok:0" \
        2>>"$LOG"
done

log "configuring git: name=${NAME@Q} email=${EMAIL@Q} github=${GITHUB@Q}"

if ! git config --global user.name "$NAME" 2>>"$LOG"; then
    log "warn: git config user.name failed"
fi
if ! git config --global user.email "$EMAIL" 2>>"$LOG"; then
    log "warn: git config user.email failed"
fi
if [[ -n "${GITHUB:-}" ]]; then
    if ! git config --global github.user "$GITHUB" 2>>"$LOG"; then
        log "warn: git config github.user failed"
    fi
fi

touch "$MARKER_FILE" 2>>"$LOG" || log "warn: could not touch marker"

yad --info \
    --title="Setup Complete" \
    --text="<b>Your development environment is ready\!</b>\n\nGit has been configured with:\n\n<tt>Name:  $NAME\nEmail: $EMAIL</tt>\n\nUse <tt>shedman install &lt;pkg&gt;</tt> to install any additional packages." \
    --width=400 \
    --center \
    --window-icon=preferences-system \
    --image=emblem-default \
    --button="Continue:0" \
    2>>"$LOG"

log "welcome flow complete"
exit 0
