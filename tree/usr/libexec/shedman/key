#!/usr/bin/env bash
# shedman key; change the disk passphrase, manage keyslots, and rotate the paper
# recovery key on an encrypted box. Every change applies to all boot-unlocked
# LUKS containers (root + swap); secrets always move over stdin, never argv.

set -uo pipefail

PROG="shedman key"
CONTAINERS_FILE=${SHEDMAN_KEY_CONTAINERS:-/etc/shedos/secureboot/containers}
CRYPTTAB=${SHEDMAN_CRYPTTAB:-/etc/crypttab}

# Canonical recovery-key format, shared with the installer's escrow module so a
# rotated key reads and types exactly like the one set at install.
_RECOVERY_ALPHABET='ABCDEFGHJKMNPRSTVWXYZ347'   # 24 unambiguous symbols
_RECOVERY_SYMBOLS=25                            # ~114 bits at log2(24)

_die() { echo "$PROG: $1" >&2; exit "${2:-1}"; }

_require_root() {
    if [[ $(id -u) -ne 0 ]]; then
        echo "$PROG: $1 requires root" >&2
        exit 1
    fi
}

# Map a crypttab field-2 source (UUID=x, PARTUUID=x, or a bare path) to a
# device path cryptsetup can open.
_resolve_crypttab_source() {
    local src=$1
    case "$src" in
        UUID=*)     printf '/dev/disk/by-uuid/%s\n' "${src#UUID=}" ;;
        PARTUUID=*) printf '/dev/disk/by-partuuid/%s\n' "${src#PARTUUID=}" ;;
        LABEL=*)    printf '/dev/disk/by-label/%s\n' "${src#LABEL=}" ;;
        *)          printf '%s\n' "$src" ;;
    esac
}

# The boot-unlocked LUKS containers, root first. Prefer the install-written
# list; fall back to crypttab so an older box still resolves.
_resolve_containers() {
    local line name dev
    if [[ -s $CONTAINERS_FILE ]]; then
        while read -r line; do
            line=${line%%#*}
            line=${line//[[:space:]]/}
            [[ -n $line ]] && printf '%s\n' "$line"
        done < "$CONTAINERS_FILE"
        return 0
    fi
    [[ -r $CRYPTTAB ]] || return 0
    while read -r name dev _; do
        [[ -z $name || $name == \#* || -z $dev ]] && continue
        _resolve_crypttab_source "$dev"
    done < "$CRYPTTAB"
}

_load_containers() {
    mapfile -t CONTAINERS < <(_resolve_containers)
    if (( ${#CONTAINERS[@]} == 0 )); then
        echo "$PROG: found no encrypted disks to manage" >&2
        exit 1
    fi
}

# Gate every mutating action on an explicit yes. A non-TTY only proceeds when
# the caller passed --yes; we never auto-confirm a security action.
_confirm() {
    local prompt=$1 answer
    if [[ -n ${ASSUME_YES:-} ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        echo "$PROG: refusing to continue without confirmation; pass --yes to proceed non-interactively" >&2
        exit 1
    fi
    read -r -p "$prompt" answer
    if [[ $answer != yes ]]; then
        echo "$PROG: aborted" >&2
        exit 1
    fi
}

_dump_json() { cryptsetup luksDump --dump-json-metadata "$1" 2>/dev/null; }

# Print "slot N: <role>" per keyslot, reading roles from LUKS2 tokens:
# shedos-recovery -> recovery, shedos-added -> added passphrase,
# systemd-tpm2 -> tpm2, systemd-fido2 -> fido2; an untagged slot 0 is the
# passphrase, any other untagged slot is unlabeled.
_cmd_status() {
    _load_containers
    local dev json slots s role
    for dev in "${CONTAINERS[@]}"; do
        echo "$dev:"
        json=$(_dump_json "$dev")
        slots=$(jq -r '.keyslots | keys[]' <<<"$json" 2>/dev/null | sort -n)
        for s in $slots; do
            role=$(_role_in_json "$json" "$s")
            case "$role" in
                shedos-recovery) role=recovery ;;
                shedos-added)    role="added passphrase" ;;
                systemd-tpm2)    role=tpm2 ;;
                systemd-fido2)   role=fido2 ;;
                "")              role=$([[ $s == 0 ]] && echo passphrase || echo unlabeled) ;;
            esac
            echo "  slot $s: $role"
        done
    done
}

# Read a secret from a pipe (non-TTY) or prompt for it silently on the TTY.
_read_secret() {
    local p=$1 v
    if [[ -t 0 ]]; then read -r -s -p "$p" v; echo >&2; else read -r v; fi
    printf '%s' "$v"
}

# Read a new secret twice and confirm it matches; refuse an empty one.
_read_new_secret() {
    local v1 v2
    v1=$(_read_secret "New $1: ")
    v2=$(_read_secret "Repeat $1: ")
    [[ $v1 == "$v2" ]] || _die "the two entries did not match" 1
    [[ -n $v1 ]] || _die "an empty $1 is refused" 1
    printf '%s' "$v1"
}

# Write a secret to a private 0600 tmpfs file with no trailing newline (so the
# enrolled key byte-matches what is typed at the boot prompt) and echo its path.
# cryptsetup cannot read a NEW key from a pipe, so it needs a real file; the
# caller removes it. SHEDMAN_KEY_TMPDIR lets the tests redirect it off /run.
_mk_keyfile() {
    local f
    f=$(mktemp -p "${SHEDMAN_KEY_TMPDIR:-/run}" shedos-key.XXXXXX) || _die "could not create a temporary keyfile" 1
    chmod 600 "$f"
    printf '%s' "$1" > "$f"
    printf '%s' "$f"
}

# A fresh recovery key: 25 uppercase symbols from the unambiguous alphabet,
# grouped into fives with dashes. Uniform via /dev/urandom rejection sampling
# (256 % 24 != 0, so drop bytes >= 240); never $RANDOM.
_gen_recovery() {
    local n=${#_RECOVERY_ALPHABET} out="" count=0 byte
    while (( count < _RECOVERY_SYMBOLS )); do
        byte=$(head -c1 /dev/urandom | od -An -tu1 | tr -d ' ')
        (( byte >= 240 )) && continue
        out+=${_RECOVERY_ALPHABET:$(( byte % n )):1}
        (( count++ ))
    done
    sed 's/.\{5\}/&-/g; s/-$//' <<<"$out"
}

# Every spelling the boot prompt should accept for $1: the key as given and its
# lowercasing, each with and without dashes, deduplicated. Mirrors the escrow
# module so a rotated key forgives Caps Lock and dashes exactly like install.
_recovery_forms() {
    local base f
    declare -A seen=()
    for base in "$1" "${1,,}"; do
        for f in "$base" "${base//-/}"; do
            [[ -n ${seen[$f]:-} ]] || { printf '%s\n' "$f"; seen[$f]=1; }
        done
    done
}

# --- LUKS2 token helpers: slots carry a token naming their ShedOS role -------

_active_slots() { _dump_json "$1" | jq -r '.keyslots | keys[]' 2>/dev/null | sort -n; }

# Slots carrying a token of the given type (e.g. shedos-recovery), one per line.
_slots_with_token() {  # $1=dev $2=type
    _dump_json "$1" | jq -r --arg t "$2" '
        (.tokens // {}) | to_entries | map(select(.value.type == $t))
        | map(.value.keyslots[]) | .[]' 2>/dev/null | sort -n
}

# Attach a custom-type LUKS2 token to a slot — a pure role label. The JSON goes
# through a file because `token import` will not read it from a pipe; it is not
# secret, but reuse the private tmpdir anyway.
_tag_slot() {  # $1=dev $2=slot $3=type
    local jf rc
    jf=$(mktemp -p "${SHEDMAN_KEY_TMPDIR:-/run}" shedos-tok.XXXXXX) || _die "could not create a temp file" 1
    printf '{"type":"%s","keyslots":["%s"]}' "$3" "$2" > "$jf"
    cryptsetup token import --json-file="$jf" "$1" 2>/dev/null; rc=$?
    rm -f "$jf"
    return $rc
}

# The token-id whose keyslots references a slot, or empty. Used to clean up the
# token cryptsetup leaves behind after luksKillSlot.
_token_id_of_slot() {  # $1=dev $2=slot
    _dump_json "$1" | jq -r --arg s "$2" '
        (.tokens // {}) | to_entries
        | map(select(.value.keyslots | index($s))) | (.[0].key // "")' 2>/dev/null
}

# Remove the (now dangling) token for a slot, if any.
_untag_slot() {  # $1=dev $2=slot
    local id; id=$(_token_id_of_slot "$1" "$2")
    [[ -n $id ]] && cryptsetup token remove --token-id "$id" "$1" 2>/dev/null
    return 0
}

# The single slot that appeared since a newline-list snapshot of _active_slots.
_new_slot_after() {  # $1=dev $2=before-list
    comm -13 <(printf '%s\n' "$2" | sort -n) <(_active_slots "$1") | head -n1
}

# The token type tagged on a slot (shedos-recovery, systemd-tpm2, …) or "" if
# untagged. _role_in_json reads an already-dumped header (no extra luksDump);
# _role_of_slot dumps first.
_role_in_json() {  # $1=json $2=slot
    jq -r --arg s "$2" '(.tokens//{})|to_entries|map(select(.value.keyslots|index($s)))|(.[0].value.type//"")' <<<"$1" 2>/dev/null
}
_role_of_slot() { _role_in_json "$(_dump_json "$1")" "$2"; }

_cmd_change_passphrase() {
    _require_root change-passphrase
    _load_containers
    local old new dev kf
    old=$(_read_secret "Current passphrase: ")
    new=$(_read_new_secret "passphrase")
    _confirm "Type 'yes' to change the passphrase on all encrypted disks: "
    for dev in "${CONTAINERS[@]}"; do
        kf=$(_mk_keyfile "$new")
        if ! printf '%s' "$old" | cryptsetup luksChangeKey "$dev" --key-file=- "$kf" 2>/dev/null; then
            rm -f "$kf"
            _die "could not change the passphrase on $dev (is the current passphrase correct?)" 1
        fi
        rm -f "$kf"
        echo "$PROG: passphrase changed on $dev"
    done
    echo "$PROG: done. TPM2 unlock (if enrolled) is unaffected — no re-enrol needed."
}

# An older box installed before tokens shipped has untagged recovery slots.
# Find them by testing each slot against the current recovery key and tag them,
# so rotation can target exactly the recovery slots and nothing else.
_backfill_recovery_tokens() {  # $1=dev $2=current-recovery-key
    local dev=$1 oldkey=$2 slot
    for slot in $(_active_slots "$dev"); do
        if printf '%s' "$oldkey" | cryptsetup open --test-passphrase --key-slot "$slot" --key-file=- "$dev" 2>/dev/null; then
            _tag_slot "$dev" "$slot" shedos-recovery
        fi
    done
}

_cmd_rotate_recovery() {
    _require_root rotate-recovery
    _load_containers
    local pass dev newkey oldrec=""
    pass=$(_read_secret "Current passphrase: ")

    # Tag the recovery slots on any container that isn't labelled yet.
    for dev in "${CONTAINERS[@]}"; do
        if [[ -z $(_slots_with_token "$dev" shedos-recovery) ]]; then
            [[ -n $oldrec ]] || oldrec=$(_read_secret "Current recovery key (to locate the old slots): ")
            _backfill_recovery_tokens "$dev" "$oldrec"
        fi
    done

    newkey=$(_gen_recovery)
    cat <<EOF

  Your new recovery key:

      $newkey

  Write it down and keep it somewhere safe, separate from this machine. The old
  recovery key stops working once you confirm.

EOF
    _confirm "Type 'yes' once you have written it down: "

    local -a forms
    mapfile -t forms < <(_recovery_forms "$newkey")
    for dev in "${CONTAINERS[@]}"; do
        local before old_slots f kf s
        before=$(_active_slots "$dev")
        old_slots=$(_slots_with_token "$dev" shedos-recovery)
        # ADD every new form first (authorized by the passphrase), so the old key
        # keeps working until the new one is proven.
        for f in "${forms[@]}"; do
            kf=$(_mk_keyfile "$f")
            if ! printf '%s' "$pass" | cryptsetup luksAddKey --key-file=- "$dev" "$kf" 2>/dev/null; then
                rm -f "$kf"
                _die "could not add the new recovery key to $dev — nothing was removed; your old key still works" 1
            fi
            rm -f "$kf"
        done
        # Tag the newly-added slots.
        for s in $(comm -13 <(printf '%s\n' "$before") <(_active_slots "$dev")); do
            _tag_slot "$dev" "$s" shedos-recovery
        done
        # Prove a new form opens the disk before retiring anything.
        if ! printf '%s' "${forms[0]}" | cryptsetup open --test-passphrase --key-file=- "$dev" 2>/dev/null; then
            _die "the new recovery key did not verify on $dev — the old key was left intact" 1
        fi
        # Retire the old recovery slots and clear their now-dangling tokens.
        for s in $old_slots; do
            printf '%s' "$pass" | cryptsetup luksKillSlot --key-file=- "$dev" "$s" 2>/dev/null
            _untag_slot "$dev" "$s"
        done
        echo "$PROG: recovery key rotated on $dev"
    done
    echo "$PROG: done. Store the new recovery key somewhere safe."
}

_cmd_add_key() {
    _require_root add-key
    _load_containers
    [[ -n ${FIDO2:-} ]] && { _cmd_add_fido2; return; }
    local auth new dev
    auth=$(_read_secret "An existing passphrase (to authorize): ")
    new=$(_read_new_secret "passphrase to add")
    _confirm "Type 'yes' to add a passphrase keyslot to all encrypted disks: "
    for dev in "${CONTAINERS[@]}"; do
        local before kf s
        before=$(_active_slots "$dev")
        kf=$(_mk_keyfile "$new")
        if ! printf '%s' "$auth" | cryptsetup luksAddKey --key-file=- "$dev" "$kf" 2>/dev/null; then
            rm -f "$kf"
            _die "could not add a keyslot to $dev (is the authorizing passphrase correct?)" 1
        fi
        rm -f "$kf"
        s=$(_new_slot_after "$dev" "$before"); [[ -n $s ]] && _tag_slot "$dev" "$s" shedos-added
        echo "$PROG: added a passphrase keyslot on $dev"
    done
    echo "$PROG: done. The new passphrase unlocks every disk at boot."
}

# Enroll a FIDO2/YubiKey on every container. systemd-cryptenroll prompts for an
# existing passphrase to authorize (same as the tpm2 verb) and the token lands
# in the LUKS2 header. No crypttab or cmdline wiring: ShedOS unlocks from
# rd.luks.name on the kernel cmdline, and systemd-cryptsetup auto-tries enrolled
# header tokens at boot — so the key just prompts for a touch. Called only from
# _cmd_add_key, with root + CONTAINERS already established.
_cmd_add_fido2() {
    local dev
    _confirm "Type 'yes' to enroll a FIDO2 key on all encrypted disks (touch it when it blinks): "
    for dev in "${CONTAINERS[@]}"; do
        if systemd-cryptenroll --fido2-device=auto "$dev"; then
            echo "$PROG: enrolled FIDO2 unlock on $dev"
        else
            _die "FIDO2 enrollment failed on $dev (is the key plugged in?)" 1
        fi
    done
    echo "$PROG: done. Reboot and touch your key when the unlock prompt appears."
}

_cmd_remove_key() {
    local sel=$1
    _require_root remove-key
    [[ -n $sel ]] || _die "say which keyslot to remove (a slot number; see: $PROG --status)" 2
    _load_containers
    local dev
    for dev in "${CONTAINERS[@]}"; do
        local json slots role durable s
        json=$(_dump_json "$dev")
        mapfile -t slots < <(jq -r '.keyslots|keys[]' <<<"$json" 2>/dev/null | sort -n)
        (( ${#slots[@]} <= 1 )) && _die "removing your last keyslot on $dev would lock you out — nothing to fall back to" 1
        printf '%s\n' "${slots[@]}" | grep -qx "$sel" || _die "no slot $sel on $dev (see: $PROG --status)" 1
        role=$(_role_in_json "$json" "$sel")
        case "$role" in
            systemd-tpm2)  _die "slot $sel is the TPM2 unlock slot — remove it with: shedman tpm2 remove" 1 ;;
            systemd-fido2) _die "slot $sel is a FIDO2 slot — remove it with: systemd-cryptenroll --wipe-slot=$sel $dev" 1 ;;
        esac
        # Never strip the last interactive way in: a TPM2/FIDO2 slot can fail
        # (firmware update, lost key), so keep at least one passphrase or
        # recovery key. tpm2/fido2 slots were already refused above.
        durable=0
        for s in "${slots[@]}"; do
            case "$(_role_in_json "$json" "$s")" in
                systemd-tpm2|systemd-fido2) ;;
                *) durable=$((durable + 1)) ;;
            esac
        done
        (( durable <= 1 )) && _die "slot $sel is your last passphrase or recovery key on $dev — keep one (a TPM2 or FIDO2 slot alone can fail); add a new key first" 1
    done
    local auth; auth=$(_read_secret "An existing passphrase or recovery key (to authorize): ")
    _confirm "Type 'yes' to remove keyslot $sel from all encrypted disks: "
    for dev in "${CONTAINERS[@]}"; do
        if ! printf '%s' "$auth" | cryptsetup luksKillSlot --key-file=- "$dev" "$sel" 2>/dev/null; then
            _die "could not remove slot $sel from $dev (is the passphrase correct?)" 1
        fi
        _untag_slot "$dev" "$sel"   # clear the token cryptsetup leaves dangling
        echo "$PROG: removed keyslot $sel from $dev"
    done
}

# When sourced (the unit tests do this to reach the functions above), stop here
# with the functions defined; only a direct run reaches the help + dispatch.
[[ ${BASH_SOURCE[0]} == "${0}" ]] || return 0

case "${1:-}" in
    --help-summary)
        echo "change the passphrase, manage keyslots, rotate the recovery key"
        exit 0
        ;;
    --complete-bash|--complete-zsh)
        printf '%s\n' change-passphrase rotate-recovery add-key remove-key --status --fido2 --yes -y --help -h
        exit 0
        ;;
    --complete-fish)
        cat <<'EOF'
change-passphrase	change the disk unlock passphrase
rotate-recovery	mint a new recovery key and retire the old one
add-key	add another passphrase, or a FIDO2/YubiKey
remove-key	remove a keyslot (never your last way in)
--status	show keyslots and what each one is
--fido2	with add-key: enroll a FIDO2/YubiKey
--yes	skip the confirmation prompt
-y	skip the confirmation prompt
--help	show usage
-h	show usage
EOF
        exit 0
        ;;
    --help|-h|"")
        cat <<EOF
Usage: sudo $PROG change-passphrase [--yes]
       sudo $PROG rotate-recovery [--yes]
       sudo $PROG add-key [--fido2] [--yes]
       sudo $PROG remove-key <slot> [--yes]
            $PROG --status

Manage the keys on this machine's encrypted disk. Every change applies to all
boot-unlocked containers (root and encrypted swap) and keeps a working way in
at every step.

  change-passphrase            change the disk unlock passphrase
  rotate-recovery              mint a new recovery key and retire the old one
  add-key [--fido2]            add another passphrase, or a FIDO2/YubiKey
  remove-key <slot>            remove a keyslot (never your last way in)
  --status                     show keyslots and what each one is
  -y, --yes                    skip the confirmation prompt
  -h, --help                   show this help
EOF
        exit 0
        ;;
esac

action=${1:-}; shift || true
ASSUME_YES=
FIDO2=
args=()
for arg in "$@"; do
    case "$arg" in
        --yes|-y) ASSUME_YES=1 ;;
        --fido2)  FIDO2=1 ;;
        *)        args+=("$arg") ;;
    esac
done

case "$action" in
    change-passphrase) _cmd_change_passphrase ;;
    rotate-recovery)   _cmd_rotate_recovery ;;
    add-key)           _cmd_add_key ;;
    remove-key)        _cmd_remove_key "${args[0]:-}" ;;
    --status)          _cmd_status ;;
    *)
        echo "$PROG: unknown subcommand: $action" >&2
        echo "Try: $PROG --help" >&2
        exit 2
        ;;
esac
