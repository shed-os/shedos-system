#!/bin/bash
# Spawn hyprlock with the screensaver overlay above it. The screensaver
# self-dismisses on first keypress (via its Exclusive keyboard grab);
# hypridle's on-resume also stops it on activity. We don't stop it
# after hyprlock exits — both teardown paths above already cover it.

if [[ "${1:-}" == "--help-summary" ]]; then
    echo "lock the session"
    exit 0
fi

if pidof hyprlock >/dev/null; then
    exit 0
fi

systemctl --user start shedos-screensaver.service 2>/dev/null
exec hyprlock
