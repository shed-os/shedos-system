#!/usr/bin/env bash
# shedman tpm2; manage TPM2-backed disk unlock for the encrypted root.

set -uo pipefail

PROG="shedman tpm2"
CONTAINERS_FILE=${SHEDMAN_TPM2_CONTAINERS:-/etc/shedos/secureboot/containers}
PCR_PUBKEY=${SHEDMAN_PCR_PUBKEY:-/etc/shedos/secureboot/pcr-public.pem}
CRYPTTAB=${SHEDMAN_CRYPTTAB:-/etc/crypttab}
EFI_DIR=${SHEDMAN_EFI_DIR:-/sys/firmware/efi}
SB_EFIVAR=${SHEDMAN_SECUREBOOT_EFIVAR:-/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c}

case "${1:-}" in
    --help-summary)
        echo "manage TPM2-backed unlock for the encrypted disk"
        exit 0
        ;;
    --complete-bash|--complete-zsh)
        printf '%s\n' enroll re-enroll remove --status --with-pin --yes -y --help -h
        exit 0
        ;;
    --complete-fish)
        cat <<'EOF'
enroll	enroll passwordless TPM2 unlock on the encrypted disk
re-enroll	rotate the TPM2 unlock slot (wipe then re-enroll)
remove	drop the TPM2 unlock slot (passphrase + recovery untouched)
--status	show TPM2 unlock enrollment status
--with-pin	also require a PIN at unlock (rollback/coercion resistance)
--yes	skip the confirmation prompt (non-interactive enroll)
-y	skip the confirmation prompt (non-interactive enroll)
--help	show usage
-h	show usage
EOF
        exit 0
        ;;
    --help|-h|"")
        cat <<EOF
Usage: sudo $PROG enroll [--with-pin] [--yes]
       sudo $PROG re-enroll [--with-pin] [--yes]
       sudo $PROG remove [--yes]
       $PROG --status

Manages TPM2-backed unlock so the encrypted disk opens without typing a
passphrase on a trusted boot. The passphrase and recovery key always stay
enrolled as fallback; TPM2 unlock only works under Secure Boot.

  enroll [--with-pin]          enable passwordless TPM2 unlock (add-only; needs root)
  re-enroll [--with-pin]       rotate the TPM2 slot after a key change (needs root)
  remove                       drop the TPM2 slot, keep passphrase + recovery (needs root)
  --status                     show TPM2 unlock enrollment status
  --with-pin                   also require a short PIN at unlock
  -y, --yes                    skip the confirmation prompt (non-interactive)
  -h, --help                   show this help
EOF
        exit 0
        ;;
esac

_is_uefi() { [[ -d $EFI_DIR ]]; }

# SecureBoot efivar is a 5-byte blob: a 4-byte attribute prefix then the
# boolean. byte[4] == 1 means Secure Boot is active.
_secureboot_active() {
    [[ -r $SB_EFIVAR ]] || return 1
    [[ $(od -An -j4 -N1 -tu1 "$SB_EFIVAR" 2>/dev/null | tr -d ' ') == 1 ]]
}

# Map a crypttab field-2 source (UUID=x, PARTUUID=x, or a bare path) to a
# device path systemd-cryptenroll can open.
_resolve_crypttab_source() {
    local src=$1
    case "$src" in
        UUID=*)     printf '/dev/disk/by-uuid/%s\n' "${src#UUID=}" ;;
        PARTUUID=*) printf '/dev/disk/by-partuuid/%s\n' "${src#PARTUUID=}" ;;
        LABEL=*)    printf '/dev/disk/by-label/%s\n' "${src#LABEL=}" ;;
        *)          printf '%s\n' "$src" ;;
    esac
}

# The boot-unlocked LUKS containers, root first. Prefer the install-written
# list; fall back to crypttab so an older box still resolves.
_resolve_containers() {
    local line name dev
    if [[ -s $CONTAINERS_FILE ]]; then
        while read -r line; do
            line=${line%%#*}
            line=${line//[[:space:]]/}
            [[ -n $line ]] && printf '%s\n' "$line"
        done < "$CONTAINERS_FILE"
        return 0
    fi
    [[ -r $CRYPTTAB ]] || return 0
    while read -r name dev _; do
        [[ -z $name || $name == \#* || -z $dev ]] && continue
        _resolve_crypttab_source "$dev"
    done < "$CRYPTTAB"
}

_require_root() {
    if [[ $(id -u) -ne 0 ]]; then
        echo "$PROG: $1 requires root" >&2
        exit 1
    fi
}

# The shared SB + signing-key gate. enroll and re-enroll bind the slot to the
# signed PCR-11 policy, which is meaningless without Secure Boot and the
# per-box signing key, so refuse loudly rather than enroll a slot that can't
# unlock.
_require_secureboot_and_key() {
    if ! _is_uefi || ! _secureboot_active; then
        echo "$PROG: TPM2 unlock needs Secure Boot active; refusing to enroll" >&2
        exit 1
    fi
    if [[ ! -r $PCR_PUBKEY ]]; then
        echo "$PROG: no Secure Boot signing key found; run 'shedman secureboot enroll' first" >&2
        exit 1
    fi
}

_load_containers() {
    mapfile -t CONTAINERS < <(_resolve_containers)
    if (( ${#CONTAINERS[@]} == 0 )); then
        echo "$PROG: found no encrypted disks to manage" >&2
        exit 1
    fi
}

# Gate every mutating action on an explicit yes. A non-TTY only proceeds when
# the caller passed --yes; we never auto-confirm a security action.
_confirm() {
    local prompt=$1 answer
    if [[ -n ${ASSUME_YES:-} ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        echo "$PROG: refusing to continue without confirmation; pass --yes to proceed non-interactively" >&2
        exit 1
    fi
    read -r -p "$prompt" answer
    if [[ $answer != yes ]]; then
        echo "$PROG: aborted" >&2
        exit 1
    fi
}

# The informed-consent warning shared by enroll and re-enroll: both establish
# the same rollback exposure, so both must spell it out before the prompt.
_warn_rollback() {
    cat >&2 <<EOF
$PROG: this enables passwordless unlock on a trusted boot.

The passphrase and recovery key stay enrolled as fallback — make sure you have
both stored safely before continuing.

Tradeoff: a TPM2 slot bound to the signing key unlocks for any kernel that key
has ever signed, so a physical attacker could roll back to an older signed
kernel. Re-run with --with-pin to also require a PIN at unlock.
EOF
}

_enroll_one() {
    local dev=$1 cmd
    cmd=(systemd-cryptenroll --tpm2-device=auto
         --tpm2-public-key="$PCR_PUBKEY" --tpm2-public-key-pcrs=11)
    [[ -n ${WITH_PIN:-} ]] && cmd+=(--tpm2-with-pin=yes)
    cmd+=("$dev")
    "${cmd[@]}"
}

_wipe_one() {
    systemd-cryptenroll --wipe-slot=tpm2 "$1"
}

action=$1
shift
WITH_PIN=
ASSUME_YES=
for arg in "$@"; do
    case "$arg" in
        --with-pin) WITH_PIN=1 ;;
        --yes|-y)   ASSUME_YES=1 ;;
        *)
            echo "$PROG: unknown option: $arg" >&2
            echo "Try: $PROG --help" >&2
            exit 2
            ;;
    esac
done

case "$action" in
    enroll)
        _require_root enroll
        _require_secureboot_and_key
        _load_containers
        _warn_rollback
        _confirm "Type 'yes' to enroll TPM2 unlock: "
        failed=()
        for dev in "${CONTAINERS[@]}"; do
            if _enroll_one "$dev"; then
                echo "$PROG: enrolled TPM2 unlock on $dev"
            else
                echo "$PROG: failed to enroll TPM2 unlock on $dev; a TPM2 slot may already exist (use '$PROG re-enroll' to rotate)" >&2
                failed+=("$dev")
            fi
        done
        (( ${#failed[@]} == 0 )) || exit 1
        ;;
    re-enroll)
        _require_root re-enroll
        _require_secureboot_and_key
        _load_containers
        _warn_rollback
        _confirm "Type 'yes' to rotate the TPM2 unlock slot: "
        failed=()
        for dev in "${CONTAINERS[@]}"; do
            _wipe_one "$dev" >/dev/null 2>&1
            if _enroll_one "$dev"; then
                echo "$PROG: re-enrolled TPM2 unlock on $dev"
            else
                echo "$PROG: failed to re-enroll TPM2 unlock on $dev" >&2
                failed+=("$dev")
            fi
        done
        (( ${#failed[@]} == 0 )) || exit 1
        ;;
    remove)
        _require_root remove
        _load_containers
        _confirm "Type 'yes' to remove the TPM2 unlock slot: "
        failed=()
        for dev in "${CONTAINERS[@]}"; do
            if _wipe_one "$dev"; then
                echo "$PROG: removed TPM2 unlock from $dev"
            else
                echo "$PROG: failed to remove TPM2 unlock from $dev" >&2
                failed+=("$dev")
            fi
        done
        (( ${#failed[@]} == 0 )) || exit 1
        ;;
    --status)
        _load_containers
        for dev in "${CONTAINERS[@]}"; do
            dump=$(cryptsetup luksDump "$dev" 2>/dev/null)
            if [[ -z $dump ]]; then
                echo "  $dev: unable to read (try: sudo $PROG --status)"
            elif grep -q 'systemd-tpm2' <<<"$dump"; then
                echo "  $dev: TPM2 unlock enrolled"
            else
                echo "  $dev: passphrase only (run: sudo $PROG enroll)"
            fi
        done
        ;;
    *)
        echo "$PROG: unknown option: $action" >&2
        echo "Try: $PROG --help" >&2
        exit 2
        ;;
esac
