#!/usr/bin/env bash
# Heal pre-rc4 ShedOS installs whose locale/man/doc/info files were
# stripped from the squashfs by the old airootfs-slim hook. Pacman's
# local db tracks those files; libalpm warns on every transaction
# because lstat() returns ENOENT. Reinstalling the affected packages
# with --overwrite restores the files and silences the warnings.
#
# Idempotent: a marker at /var/lib/shedos/locale-restore.done makes
# subsequent runs a no-op. systemd's ConditionPathExists also gates
# re-runs.
#
# Exits 0 on success or when there's nothing to do. Exits non-zero
# only if pacman -S fails or if files are still missing after the
# reinstall (in which case the unit re-fires on the next boot via
# the missing marker).

set -uo pipefail

MARKER=/var/lib/shedos/locale-restore.done
LOG_PREFIX="shedos-locale-restore"

log() { printf '%s: %s\n' "$LOG_PREFIX" "$*"; }
die() { printf '%s: %s\n' "$LOG_PREFIX" "$*" >&2; exit 1; }

if [[ -f $MARKER ]]; then
    log "already complete (marker at $MARKER)"
    exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
    die "pacman not on PATH; nothing to do"
fi

# Best-effort network gate beyond systemd's network-online.target.
# Some networks let the target fire before DNS works; check explicitly
# so we don't churn through pacman with a half-up stack. Exit clean: a
# WiFi box has no network this early on its first boots, and a failed
# unit keeps the whole system 'degraded' — the missing marker already
# re-fires the unit next boot.
if ! getent ahosts archlinux.org >/dev/null 2>&1; then
    log "no network yet (getent ahosts archlinux.org failed); retrying next boot"
    exit 0
fi

log "scanning pacman db for files-in-db-missing-on-disk..."

# One full -Qkk per boot; both the gap check and the per-package
# classification below read this capture. (A full -Qkk walks every
# installed file — running it repeatedly is what made this unit the
# slowest part of boot on affected machines.)
QKK_MISSING=$(pacman -Qkk 2>&1 1>/dev/null \
    | grep -E ': /.* \(No such file or directory\)$' || true)

if ! grep -qE ': /(usr/share/locale|usr/share/man|usr/share/doc|usr/share/info)/' \
        <<<"$QKK_MISSING"; then
    log "no locale/man/doc/info gaps; nothing to repair"
    install -Dm644 /dev/null "$MARKER"
    exit 0
fi

# Filter to packages whose ONLY missing files are under the four
# prefixes. A package with unrelated missing files (e.g., a corrupt
# install) should not be silently --overwrite'd here.
declare -A PKG_HAS_OTHER_MISS=()
declare -A PKG_HAS_TARGET_MISS=()

while IFS= read -r line; do
    [[ -n $line ]] || continue
    pkg=${line%%:*}
    [[ -n $pkg ]] || continue
    if [[ $line =~ :\ /(usr/share/locale|usr/share/man|usr/share/doc|usr/share/info)/ ]]; then
        PKG_HAS_TARGET_MISS[$pkg]=1
    else
        PKG_HAS_OTHER_MISS[$pkg]=1
    fi
done <<<"$QKK_MISSING"

PKGS=()
for pkg in "${!PKG_HAS_TARGET_MISS[@]}"; do
    if [[ -z ${PKG_HAS_OTHER_MISS[$pkg]:-} ]]; then
        PKGS+=("$pkg")
    fi
done

if (( ${#PKGS[@]} == 0 )); then
    log "no packages with locale/man/doc/info-only gaps; nothing to repair"
    install -Dm644 /dev/null "$MARKER"
    exit 0
fi

# Stable order for log readability.
mapfile -t PKGS < <(LC_ALL=C printf '%s\n' "${PKGS[@]}" | sort -u)

log "repairing ${#PKGS[@]} package(s): ${PKGS[*]}"

# --overwrite '*' is safe here because every file we're restoring is
# by definition absent from disk; pacman cannot clobber user edits to
# files that aren't there. No --needed: the broken packages are
# already at the installed version (their files are missing, not
# outdated), so --needed skipped exactly the packages we came to
# repair and the unit failed verification on every boot.
if ! pacman -S --overwrite '*' --noconfirm "${PKGS[@]}"; then
    die "pacman -S failed; will retry on next boot"
fi

log "verifying no locale/man/doc/info gaps remain..."

# Scoped to the repaired packages — a full -Qkk walks the world.
if pacman -Qkk "${PKGS[@]}" 2>&1 1>/dev/null \
    | grep -qE ': /(usr/share/locale|usr/share/man|usr/share/doc|usr/share/info)/.* \(No such file or directory\)$'; then
    die "files still missing after reinstall; retrying on next boot"
fi

install -Dm644 /dev/null "$MARKER"
log "done; marker written to $MARKER"
