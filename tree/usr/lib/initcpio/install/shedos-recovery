#!/bin/bash
# mkinitcpio install hook: ship the boot-failure auto-recovery into
# the systemd initrd. Pairs with shedos-boot-success.service on the
# full system, which resets the counter once the greeter is up.

build() {
    # TPM2-PIN boxes carry a drop-in that flips systemd-cryptsetup onto
    # its native unlock path (five PIN attempts, then the passphrase
    # prompt). It has to ride into the initrd; no-op everywhere else.
    local pin_dropin=/etc/systemd/system/systemd-cryptsetup@.service.d/10-shedos-tpm2-pin.conf
    if [[ -f $pin_dropin ]]; then
        add_file "$pin_dropin"
    fi

    # One prompt that takes a PIN, a passphrase, or a recovery key, handed to
    # systemd-cryptsetup as a credential so it never asks a second time.
    # cryptsetup is here for the keyslot test, not to open anything.
    add_binary /usr/bin/cryptsetup
    add_binary /usr/bin/systemd-ask-password
    add_file /usr/lib/shedos/shedos-unlock
    add_systemd_unit shedos-unlock.service
    add_systemd_unit shedos-unlock-disarm.service
    # mkinitcpio has no add_systemd_drop_in, and the drop-in is what orders
    # every generated systemd-cryptsetup@ instance after the prompt.
    add_file /usr/lib/systemd/system/systemd-cryptsetup@.service.d/10-shedos-unlock.conf
    cd "$BUILDROOT" || return 1
    mkdir -p usr/lib/systemd/system/initrd.target.wants
    ln -sf ../shedos-unlock-disarm.service \
        usr/lib/systemd/system/initrd.target.wants/shedos-unlock-disarm.service

    add_binary /usr/bin/btrfs
    # initrd-recovery.sh is #!/bin/bash and uses bashisms ([[, ((, =~,
    # $(<file)); a systemd initrd carries only busybox /bin/sh, so bash
    # has to be staged explicitly or the recovery one-shot can't exec.
    add_binary /usr/bin/bash
    add_file /usr/lib/shedos/initrd-recovery.sh
    add_systemd_unit shedos-initrd-recovery.service
    mkdir -p usr/lib/systemd/system/initrd-root-fs.target.wants
    ln -sf ../shedos-initrd-recovery.service \
        usr/lib/systemd/system/initrd-root-fs.target.wants/shedos-initrd-recovery.service
}

help() {
    cat <<HELPEOF
Counts consecutive boots that never reached the greeter; after three,
boots a writable clone of the newest snapper snapshot instead of the
broken root. Requires the systemd initrd hook set.
HELPEOF
}
