[Unit]
Description=In-place root reencryption driver
# Initrd-only one-shot. Like systemd-cryptsetup it PROVIDES the root device (it
# opens the LUKS mapper on a resume/bridge boot), so it must NOT order after anything
# that waits on the root: ordering after initrd-root-device.target deadlocks the
# encrypted boot, because the root lives inside the LUKS container the driver itself
# opens (proven in QEMU — it lands in Emergency Mode). It also stays off
# cryptsetup.target: on the fresh-encrypt path the root is still plaintext and the
# normal unlock must not run. It DOES order after systemd-udevd: cryptsetup open waits
# on a device-mapper udev cookie, so udevd must be up to service it (else the open
# hangs forever — also proven in QEMU). The disk-enumeration race is handled in the
# driver (_mount_esp retries blkid). Runs before sysroot.mount.
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
After=systemd-udevd.service systemd-udev-trigger.service
Before=sysroot.mount

[Service]
Type=oneshot
ExecStart=/usr/lib/shedos/reencrypt-driver.sh
RemainAfterExit=yes

[Install]
WantedBy=initrd-root-fs.target
