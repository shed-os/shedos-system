[Unit]
Description=Ensure a postgres role+database exists for each regular Linux user
Documentation=man:psql(1)
# Depends on the cluster actually existing. shedos-pg-initdb.service runs
# first-boot if PG_VERSION is missing; after that postgresql.service itself
# keeps the daemon running.
# After only — Wants= would pull postgres up even on systems
# where the user disabled it via [services.postgresql].
After=postgresql.service
ConditionPathExists=/var/lib/postgres/data/PG_VERSION

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/shedman db --pg-bootstrap
StandardOutput=journal
StandardError=journal
# Sandboxing; see shedos-pg-initdb.service for the rationale on why
# we stop short of ProtectSystem=strict for the postgres bootstraps.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
