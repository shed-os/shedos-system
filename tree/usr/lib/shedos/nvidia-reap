#!/bin/bash
# Remove the nvidia stack where no nvidia device exists; mark it
# explicit where one does. Runs once, disables itself. Doubt keeps.
set -uo pipefail

STACK_FILE=${SHEDOS_NVIDIA_STACK_FILE:-/usr/share/shedos/nvidia-driver-stack}
SYS=${SHEDOS_NVIDIA_SYS:-/sys/bus/pci/devices}
PACMAN=${SHEDOS_NVIDIA_PACMAN:-pacman}

# Without the list there is nothing to reap and no way to know it — leave the
# unit armed so a boot that can read the file gets its turn.
[[ -r $STACK_FILE ]] || exit 0
# The firmware is not in the file — the installer keeps it on legacy cards
# where nouveau wants it, and here there is no card at all to keep it for.
mapfile -t STACK < <(grep -vE '^[[:space:]]*(#|$)' "$STACK_FILE")
STACK+=(linux-firmware-nvidia)

_disarm() { systemctl disable shedos-nvidia-reap.service 2>/dev/null || true; }

# 0 = keep: nvidia found, or nothing readable to prove its absence.
_keep() {
    local v any=0
    for v in "$SYS"/*/vendor; do
        [[ -r $v ]] || continue
        any=1
        [[ $(<"$v") == 0x10de ]] && return 0
    done
    (( any == 0 ))
}

main() {
    local p
    local -a have=()
    for p in "${STACK[@]}"; do
        "$PACMAN" -Qq "$p" >/dev/null 2>&1 && have+=("$p")
    done
    if (( ${#have[@]} == 0 )); then
        _disarm
        return 0
    fi
    if _keep; then
        "$PACMAN" -D --asexplicit "${have[@]}" >/dev/null \
            || echo "nvidia-reap: could not mark the stack explicit" >&2
    else
        "$PACMAN" -Rns --noconfirm "${have[@]}" \
            || echo "nvidia-reap: removal refused; stack left in place" >&2
    fi
    _disarm
}

main "$@"
