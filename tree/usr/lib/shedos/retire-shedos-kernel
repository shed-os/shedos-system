#!/bin/bash
# First-boot retirement of the legacy shedos-kernel package.
#
# The shedos-kernel -> linux-zen migration deliberately leaves shedos-kernel
# INSTALLED through the upgrade, so the machine always keeps a known-good,
# already-booting kernel while linux-zen is added alongside it. This one-shot
# finishes the job — but only AFTER the system has actually booted linux-zen,
# so an incomplete or unbootable linux-zen can never strand the user. It
# no-ops (and disables itself) once shedos-kernel is gone.
set -uo pipefail

# Nothing to retire — already done, or a fresh linux-zen install.
if ! pacman -Qq shedos-kernel &>/dev/null; then
    systemctl disable shedos-retire-kernel.service 2>/dev/null || true
    exit 0
fi

# Fail-closed gate: only retire the old kernel when linux-zen is the kernel
# we actually booted. The running kernel's modules dir names its package.
running=$(uname -r)
booted_pkgbase=$(cat "${SHEDOS_MODULES_DIR:-/usr/lib/modules}/$running/pkgbase" 2>/dev/null || true)
if [[ $booted_pkgbase != linux-zen ]]; then
    echo "retire-shedos-kernel: booted kernel is '${booted_pkgbase:-$running}', not linux-zen — deferring to a later boot"
    exit 0
fi

# Driver-safety: don't strip shedos-kernel while linux-zen is still missing a
# DKMS module (e.g. nvidia built only for the old kernel) — that would leave the
# box with no working driver. Keep the old kernel until every module builds.
dkms_coverage=${SHEDOS_DKMS_COVERAGE:-/usr/lib/shedos/dkms-coverage}
uncovered=$("$dkms_coverage" "$running")
cov_rc=$?
if (( cov_rc == 1 )); then
    echo "retire-shedos-kernel: linux-zen ($running) is missing DKMS module(s) [${uncovered//$'\n'/ }] — keeping shedos-kernel until they build" >&2
    exit 0
elif (( cov_rc != 0 )); then
    echo "retire-shedos-kernel: could not verify DKMS coverage for linux-zen ($running) — keeping shedos-kernel this boot" >&2
    exit 0
fi

# Don't fight a concurrent pacman transaction; try again next boot.
if [[ -e /var/lib/pacman/db.lck ]]; then
    echo "retire-shedos-kernel: pacman db is locked — will retry next boot"
    exit 0
fi

# Remove whichever of the pair is still present.
remove=()
for pkg in shedos-kernel shedos-kernel-headers; do
    pacman -Qq "$pkg" &>/dev/null && remove+=("$pkg")
done

echo "retire-shedos-kernel: linux-zen confirmed running; removing ${remove[*]}"
if ! pacman -R --noconfirm "${remove[@]}"; then
    echo "retire-shedos-kernel: removal failed — leaving the old kernel in place, will retry next boot" >&2
    exit 0
fi

# vmlinuz-shedos-kernel was package-owned and pacman just removed it; the
# initramfs images were mkinitcpio-built and unowned, so clear them by hand.
rm -f /boot/initramfs-shedos-kernel.img /boot/initramfs-shedos-kernel-fallback.img

# The 95-limine hook re-renders on the removal above; re-run explicitly as a
# belt-and-suspenders so the dead shedos-kernel entry is gone for certain.
# render-limine-config.sh also prunes shedos-kernel's now-orphaned vmlinuz/
# initramfs copies off the FAT ESP (it keeps images only for installed
# kernels), reclaiming the space the two-kernel migration window needed.
[[ -x /usr/lib/shedos/render-limine-config.sh ]] && /usr/lib/shedos/render-limine-config.sh || true

systemctl disable shedos-retire-kernel.service 2>/dev/null || true
echo "retire-shedos-kernel: shedos-kernel retired; booting linux-zen from here on."
