#!/usr/bin/env bash
# The one writer of the managed blocks in /etc/pacman.conf.
#
#   pacman-fence reserved
#       the repository names this package owns, one per line, in the order
#       they are written. A declaration of either is refused rather than
#       honoured: they are the ShedOS channels and the install scriptlet is
#       what keeps them right.
#
#   pacman-fence render <stable|canary> [--commented]
#   pacman-fence render-repo <name> <server> [siglevel]
#       one fenced block on stdout.
#
#   pacman-fence rewrite [--canary-enabled]
#       a pacman.conf on stdin, the same file with exactly one canonical copy
#       of the two channels on stdout. Every other managed block is carried
#       through untouched.
#
#   pacman-fence rewrite-repos [--repo <name> <server> [siglevel]]...
#       the same from the other side: the declared repositories are replaced
#       by exactly what is named here, and the two channels are carried
#       through untouched. Each field is its own argument, because a Server
#       URL may carry an `=` of its own and a packed form would cut it there.
#
# Ownership is by name and nothing else. The scriptlet owns the two reserved
# names; whatever declares repositories owns every other name. Neither reads
# the other's text to work out whose a block is, so there is no way for a
# preamble edit to hand a block to the wrong writer.
#
# Order is canonical however the file was reached: the canary first, then the
# stable channel, then the declared repositories alphabetically. pacman hands a
# package to the first repository that lists it, so that order is what lets an
# enabled canary override stable during an RC soak, and what keeps a declared
# repository from quietly outranking both.
#
# A block between the markers is ours: a hand-written one for a repository
# nobody declared is reconciled away on the next run, and an edit inside one
# lasts until then. That is the whole of the do-not-edit contract the markers
# state.
#
# The rewrite squeezes trailing blank lines, because the append adds one and
# running twice must produce the same bytes as running once.
#
# The channel names and URLs come from the shedman config, with the values
# ShedOS ships compiled in as defaults, so an absent or unreadable file
# changes nothing.
set -uo pipefail

CONFIG=${SHEDMAN_CONFIG:-/etc/shedman/shedman.toml}

_config() {
    local key=$1 value
    value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
        "$CONFIG" 2>/dev/null | head -1)
    printf '%s\n' "${value:-$2}"
}

STABLE_REPO=$(_config repo shedos)
STABLE_URL=$(_config repo-url 'https://repo.shedos.org/stable/$arch')
CANARY_REPO=$(_config canary-repo shedostest)
CANARY_URL=$(_config canary-url 'https://repo.shedos.org/test/$arch')
SIGLEVEL='Required DatabaseRequired'

die() { printf 'pacman-fence: %s\n' "$*" >&2; exit 2; }

open_marker()  { printf '# >>> %s <<<\n' "$1"; }
close_marker() { printf '# <<< %s >>>\n' "$1"; }

# One line, the same on every block whoever wrote it, so nothing has to read a
# preamble to know what it is looking at.
preamble() { printf '# Managed by shedos-system; do not edit between these markers.\n'; }

body() {  # $1=comment prefix $2=name $3=siglevel $4=server
    printf '%s[%s]\n' "$1" "$2"
    printf '%sSigLevel = %s\n' "$1" "$3"
    printf '%sServer = %s\n' "$1" "$4"
}

render() {
    local channel=$1 c=${2:-}
    case $channel in
        stable)
            open_marker "$STABLE_REPO"
            preamble
            printf '# Run `pacman -R shedos-system` to remove automatically.\n'
            body "$c" "$STABLE_REPO" "$SIGLEVEL" "$STABLE_URL"
            close_marker "$STABLE_REPO"
            ;;
        canary)
            open_marker "$CANARY_REPO"
            preamble
            printf '# The ShedOS canary channel; RC packages land here before they are\n'
            printf '# promoted to the stable channel behind [%s]. Listed first: pacman\n' "$STABLE_REPO"
            printf '# prefers the first repository that carries a package, so enabling this\n'
            printf '# is what makes an RC install track the canary. Enable or comment the\n'
            printf '# three lines below as one to opt in or out; RC installs ship it\n'
            printf '# enabled, stable installs commented.\n'
            body "$c" "$CANARY_REPO" "$SIGLEVEL" "$CANARY_URL"
            close_marker "$CANARY_REPO"
            ;;
        *) die "no such channel: $channel" ;;
    esac
}

render_repo() {  # $1=name $2=server $3=siglevel
    open_marker "$1"
    preamble
    printf '# Declared in /etc/shedos/system.toml; a block for a repository nobody\n'
    printf '# declared is reconciled away.\n'
    body '' "$1" "$3" "$2"
    close_marker "$1"
}

# Everything outside the managed blocks on stdout; each managed block verbatim
# into $1/<name>. A bare [name] block for one of the two reserved names is an
# older airootfs template's leftover and is dropped rather than captured — it
# runs to the next section, the next blank line or the next marker, so a block
# sitting immediately above one is never swallowed with it.
strip() {
    awk -v capture="$1" -v stable="$STABLE_REPO" -v canary="$CANARY_REPO" '
        function name_of(line,   n) {
            n = line
            sub(/^# >>> /, "", n); sub(/ <<<$/, "", n)
            return n
        }
            # A repository name is what pacman will accept as a section, so a
        # marker carrying anything else is not one of ours to capture.
        /^# >>> .* <<<$/ && held == "" && name_of($0) ~ /^[A-Za-z0-9._-]+$/ {
            held = name_of($0); next
        }
        held != "" && $0 == "# <<< " held " >>>" { held = ""; next }
        held != "" { print > (capture "/" held); next }
        $0 == "[" stable "]" || $0 == "[" canary "]" { bare = 1; next }
        bare && (/^\[/ || /^[[:space:]]*$/ || /^# >>> /) { bare = 0 }
        !bare { print }
    '
}

# A captured block, marker lines and all. Nonzero and silent when the file did
# not carry one, so a caller can put the separator on the same decision.
captured() {
    [[ -s $1/$2 ]] || return 1
    open_marker "$2"
    cat "$1/$2"
    close_marker "$2"
}

# The blocks, in the order they were handed over, separated by one blank line
# each and preceded by one. Building the list first is what keeps a channel
# that was not there from leaving a stray blank line behind it.
emit_blocks() {
    local block
    for block in "$@"; do
        printf '\n%s\n' "$block"
    done
}

rewrite() {  # $1=comment prefix for the canary
    local c=$1 dir text name
    local -a blocks=()
    dir=$(mktemp -d) || die 'no temporary directory'
    text=$(strip "$dir")
    blocks+=("$(render canary "$c")" "$(render stable)")
    # Whatever else was fenced keeps its place after the channels, in name
    # order, exactly as it was written.
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        [[ $name == "$STABLE_REPO" || $name == "$CANARY_REPO" ]] && continue
        [[ -s $dir/$name ]] || continue
        blocks+=("$(captured "$dir" "$name")")
    done < <(cd "$dir" && printf '%s\n' * 2>/dev/null | LC_ALL=C sort)
    rm -rf "$dir"
    printf '%s\n' "$text"
    emit_blocks "${blocks[@]}"
}

rewrite_repos() {
    local dir text name block i
    local -a names=() servers=() siglevels=() blocks=()

    while (( $# )); do
        [[ $1 == --repo ]] || die 'rewrite-repos takes --repo <name> <server> [siglevel]'
        shift
        (( $# >= 2 )) || die '--repo takes a name and a server'
        names+=("$1"); servers+=("$2"); shift 2
        # The optional third field, told from the next --repo by the sentinel.
        if (( $# )) && [[ $1 != --repo ]]; then
            siglevels+=("$1"); shift
        else
            siglevels+=("$SIGLEVEL")
        fi
    done
    for name in "${names[@]}"; do
        refuse_reserved "$name"
    done

    dir=$(mktemp -d) || die 'no temporary directory'
    text=$(strip "$dir")
    for name in "$CANARY_REPO" "$STABLE_REPO"; do
        block=$(captured "$dir" "$name") && blocks+=("$block")
    done
    rm -rf "$dir"

    while IFS=$'\t' read -r name i; do
        [[ -n $name ]] || continue
        blocks+=("$(render_repo "$name" "${servers[$i]}" "${siglevels[$i]}")")
    done < <(for i in "${!names[@]}"; do
                 printf '%s\t%s\n' "${names[$i]}" "$i"
             done | LC_ALL=C sort)

    printf '%s\n' "$text"
    (( ${#blocks[@]} == 0 )) || emit_blocks "${blocks[@]}"
}

reserved() { printf '%s\n%s\n' "$CANARY_REPO" "$STABLE_REPO"; }

refuse_reserved() {
    [[ $1 == "$STABLE_REPO" || $1 == "$CANARY_REPO" ]] \
        && die "$1 is a ShedOS channel and shedos-system writes it"
    return 0
}

(( $# > 0 )) || die 'usage: pacman-fence reserved | render <stable|canary> [--commented] | render-repo <name> <server> [siglevel] | rewrite [--canary-enabled] | rewrite-repos [--repo <name> <server> [siglevel]]...'
verb=$1; shift

case $verb in
    reserved) reserved ;;
    render)
        (( $# > 0 )) || die 'render takes a channel'
        channel=$1; shift
        commented=
        [[ ${1:-} == --commented ]] && commented='#'
        render "$channel" "$commented"
        ;;
    render-repo)
        (( $# >= 2 )) || die 'render-repo takes a name and a server'
        refuse_reserved "$1"
        render_repo "$1" "$2" "${3:-$SIGLEVEL}"
        ;;
    rewrite)
        commented='#'
        [[ ${1:-} == --canary-enabled ]] && commented=
        rewrite "$commented"
        ;;
    rewrite-repos) rewrite_repos "$@" ;;
    *) die "no such command: $verb" ;;
esac
