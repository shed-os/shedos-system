#!/usr/bin/env bash
# /usr/lib/shedos/switch-user <username> <vt>
#
# Single capability: start a greetd login on a free VT for <username>,
# then let greetd switch the seat to it. Authorized for the active local
# seat by 49-shedos-switch-user.rules through the org.shedos.switch-user
# polkit action. The helper never authenticates anyone — greetd does,
# with the target's own password.

set -euo pipefail

PASSWD=${SHEDOS_PASSWD:-/etc/passwd}
SUPERVISOR=/usr/lib/shedos/switch-greetd-once
PRESELECT_DIR=/run/shedos
PRESELECT_FILE=$PRESELECT_DIR/switch-preselect
VT_FLOOR=7
VT_CEILING=12

die() { echo "switch-user: $1" >&2; exit "${2:-2}"; }

user=${1:-}
vt=${2:-}

[[ -n $user ]] || die "missing username"

# The target must byte-equal an enumerated regular user — the same filter
# the dropdown uses (uid 1000..<65534, real login shell), minus ShedOS's
# own accounts. Exact awk match; $user is never spliced into a command.
valid=$(awk -F: -v u="$user" \
    '$1==u && $3>=1000 && $3<65534 && $7!~"/(nologin|false)$" \
     && $1!="shedos" && $1!="greeter" {print $1; exit}' "$PASSWD")
[[ $valid == "$user" ]] || die "'$user' is not a switchable user"

# Dry-run (tests): stop after validation, never touch VTs or spawn greetd.
if [[ ${SHEDOS_SWITCH_USER_DRYRUN:-} == 1 ]]; then
    echo "switch-user: would start a login for $user"
    exit 0
fi

[[ $vt =~ ^[0-9]+$ ]] || die "vt '$vt' is not a number"
(( vt >= VT_FLOOR && vt <= VT_CEILING )) || die "vt $vt outside ${VT_FLOOR}..${VT_CEILING}" 1

# Re-validate the locker's proposed VT against reality: never the active
# console, never one logind already has a session on. The locker only
# proposes; this is where root decides. loginctl, not the session files —
# those omit the VT number on current systemd.
active=$(sed -n 's/^tty//p' /sys/class/tty/tty0/active 2>/dev/null || true)
[[ $vt != "$active" ]] || die "vt $vt is the active console" 1
if loginctl list-sessions --no-legend 2>/dev/null \
        | awk '{print $7}' | grep -qx "tty$vt"; then
    die "vt $vt is already in use" 1
fi

# Hand the validated name to the greeter about to start. The dir is
# greeter-owned (tmpfiles) so the greeter can clear it after reading.
install -d -o greeter -g greeter -m 755 "$PRESELECT_DIR"
printf '%s\n' "$user" >"$PRESELECT_FILE"
chmod 644 "$PRESELECT_FILE"

# Transient unit running the supervisor, which starts greetd on the VT
# and tears it down on logout (greetd itself would loop back to a greeter
# and hold the VT). --collect reaps the unit when the supervisor exits.
exec systemd-run --collect --unit "shedos-switch-greetd@${vt}" \
    "$SUPERVISOR" "$vt"
