#%PAM-1.0
# shedos-managed: greetd PAM; local edits land beside this as .shedosnew

# pam_gnome_keyring.so must follow the password-asking include in
# both auth and session phases; only after system-local-login has
# set PAM_AUTHTOK can pam_gnome_keyring stash + use it to unlock
# the login keyring. Reversing the order silently turns the keyring
# into a write-only sink (Chrome/VSCode then complain about a
# "weak" or empty keyring on first secret request).

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
# Fingerprint before the password stack: the greeter creates its
# greetd session eagerly, so the reader is armed from boot and a
# touch logs in without typing. A `sufficient` failure (timeout, no
# reader, no enrolled prints) falls through to the password include
# without reaching faillock's authfail accounting. Note: a touch
# login can't unlock the gnome keyring (no PAM_AUTHTOK).
auth       sufficient   pam_fprintd.so
auth       include      system-local-login
auth       optional     pam_gnome_keyring.so
account    include      system-local-login
session    include      system-local-login
session    optional     pam_gnome_keyring.so auto_start
# Record the logging-in user so the greeter can preselect them next time.
# Best-effort; the helper always exits 0 and never blocks the session.
session    optional     pam_exec.so /usr/lib/shedos/record-last-login
