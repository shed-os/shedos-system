# system.toml.example — fully-commented template for /etc/shedos/system.toml
#
# Copy sections you want to customize into /etc/shedos/system.toml and run
# `shedman apply` to reconcile. `shedman apply --dry-run` prints the plan
# without touching anything; `shedman apply --validate` only checks syntax.
#
# The schema version is frozen at 1. shedman apply refuses unknown versions
# with a pointed error — safer than silent reinterpretation.

schema = 1

# ---------------------------------------------------------------------------
# [systemd.system] / [systemd.user]
# ---------------------------------------------------------------------------
#
# `enable`  — units that should be enabled (systemctl enable). Missing
#             ones will be enabled on apply.
# `disable` — units that should be disabled. Any enabled ones get
#             disabled on apply.
#
# A unit appearing in both enable and disable is rejected at validation
# time (there is no coherent meaning for "enable and disable").
#
# User units are reconciled via `systemctl --user --global` so they apply
# to every user on this machine. Per-user exceptions are not in v1 scope.

[systemd.system]
enable = [
    "snapper-timeline.timer",
    "snapper-cleanup.timer",
    # Uncomment if this host runs the ShedOS postgres bootstrap:
    # "shedos-pg-initdb.service",
    # Uncomment to enable bluetooth at boot:
    # "bluetooth.service",
]
disable = [
    # "cups.service",   # if you don't print from this box
]

[systemd.user]
enable = [
    "shedos-update-check.timer",
    "shedos-check-health.timer",
    # "shedos-pg-user-bootstrap.service",  # if per-user-db is on
]
disable = []

# ---------------------------------------------------------------------------
# [snapper] — timeline + retention knobs for the `root` config
# ---------------------------------------------------------------------------
#
# Only the TIMELINE_* and NUMBER_LIMIT keys in /etc/snapper/configs/root are
# managed. Everything else (SUBVOLUME, QGROUP, ACL flags, user cleanup
# algos) is left untouched so snapper's own tooling stays authoritative.
#
# Omitting a subkey means "leave current value alone" — not "reset to
# zero". The declarative layer is additive over what snapper ships.

[snapper.timeline]
enabled = true   # TIMELINE_CREATE
hourly  = 5      # TIMELINE_LIMIT_HOURLY
daily   = 7      # TIMELINE_LIMIT_DAILY
weekly  = 0      # TIMELINE_LIMIT_WEEKLY
monthly = 0      # TIMELINE_LIMIT_MONTHLY
yearly  = 0      # TIMELINE_LIMIT_YEARLY

[snapper.cleanup.number]
limit = 50       # NUMBER_LIMIT — max snapshots before oldest get culled

# ---------------------------------------------------------------------------
# [drop-ins] — file-content entries under /etc/<relpath>
# ---------------------------------------------------------------------------
#
# Keys are paths RELATIVE to /etc — they must contain at least one "/" and
# end in a known config extension (.conf, .rules, .json, .cfg, ...).
# Values are the full file content as a literal TOML string.
#
# shedman apply tracks ownership of drop-ins in /var/lib/shedos/apply.state.json.
# Removing a drop-in from here deletes the file on the next apply.
#
# WARNING: do NOT declare drop-ins that are already managed by a package's
# backup=() entry (sudoers.d/wheel, sddm.conf.d/theme.conf, etc.) —
# shedman apply and pacman will fight over ownership. Stick to bespoke
# drop-ins that no package claims.

# [drop-ins]
# "systemd/coredump.conf.d/50-shedos.conf" = """\
# [Coredump]
# Storage=none
# ProcessSizeMax=0
# """
#
# "sysctl.d/99-shedos-swappiness.conf" = """\
# vm.swappiness = 10
# """

# ---------------------------------------------------------------------------
# [pacman.repos.<name>] — managed stanzas in /etc/pacman.conf
# ---------------------------------------------------------------------------
#
# shedman apply owns a fenced block between `# >>> shedos <<<` and
# `# <<< shedos >>>` in /etc/pacman.conf. The install scriptlet writes the
# initial fence on first install; ongoing edits flow through shedman apply.
#
# Each repo table below becomes one [<name>] stanza inside the fence.
# Anything outside the fence (e.g. [core], [extra], [multilib], or the
# global [options] block) is left strictly alone.
#
# Required keys per repo:
#   server    — the Server URL (supports $arch)
# Optional:
#   siglevel  — SigLevel directive (default "Required DatabaseRequired")
#
# Dropping the entire [pacman.repos] table removes all managed repos on
# the next apply (the fence stays empty). Removing a single stanza
# removes just that repo.

[pacman.repos.shedos]
server   = "https://repo.shedos.org/stable/$arch"
siglevel = "Required DatabaseRequired"

# Opt in to the canary (testing) channel by uncommenting the block
# below. RC packages land here before reaching [shedos]. Stable cuts
# also publish to /test/x86_64/, so opting in only changes behavior
# during RC windows.
#
# [pacman.repos.shedos-testing]
# server   = "https://repo.shedos.org/test/$arch"
# siglevel = "Required DatabaseRequired"

# Add your own repo:
# [pacman.repos.my-mirror]
# server   = "https://pkgs.example.org/$repo/$arch"
# siglevel = "Optional TrustAll"

# ---------------------------------------------------------------------------
# [services.postgresql] — declarative wrapper over the bootstrap units
# ---------------------------------------------------------------------------
#
# Flips below desugar to ordinary systemctl enable/disable on the two
# shedos-pg-* units. Convenience-named so users who don't run Postgres
# don't have to think about the underlying service names.
#
# Setting `auto-init = false` stops /var/lib/postgres/data from being
# initialized on next boot. Setting `per-user-db = false` skips the
# per-Linux-user role+database bootstrap.

[services.postgresql]
auto-init   = true   # controls shedos-pg-initdb.service
per-user-db = true   # controls shedos-pg-user-bootstrap.service

# ---------------------------------------------------------------------------
# [services.docker] — declarative wrapper over docker.service
# ---------------------------------------------------------------------------
#
# Docker is enabled at install time. Set `enable = false` and run
# `shedman apply` to mask docker.service on systems that don't need it.

[services.docker]
enable = true

# ---------------------------------------------------------------------------
# [network.firewall] — declarative ufw with bidirectional adoption
# ---------------------------------------------------------------------------
#
# UFW ships installed but disabled-by-default on ShedOS — uncomment and
# set `enabled = true` to opt in. ShedOS never enables the firewall for
# you.
#
# Adoption model: rules added via raw `ufw allow|deny` get adopted into
# this section on the next `shedman apply`. So the TOML and `ufw`
# remain a coherent single source of truth — edit either, the file
# always reflects current intent.
#
# Safety: removing a rule from TOML deletes it from ufw on apply.
# Removing the entire `[network.firewall]` section makes the
# reconciler invisible (it stops managing the firewall, including
# adoption). On first apply, any pre-existing ufw rules are silently
# adopted — preview with `shedman apply --dry-run` if that matters.
#
# Defaults & service flag (incoming/outgoing/routed/enabled) are only
# applied when declared. Omit them to leave any user-set defaults
# alone.
#
# Rule grammar mirrors `man ufw` ("RULE SYNTAX"):
#
#   action     allow | deny | reject | limit          (required)
#   direction  in | out                               (default: in)
#   interface  on <iface>                              (optional)
#   log        log | log-all                           (optional)
#   from       <addr> | <CIDR> | "any"                 (optional)
#   to         <addr> | <CIDR> | "any"                 (optional)
#   from-port  <N>                                     (paired with `from`)
#   to-port    <N>                                     (paired with `to`)
#   port       <N>                                     (shorthand)
#   proto      tcp | udp | ah | esp | …                (with `port` or
#                                                       `from`/`to`)
#   app        <profile name>                          (mutually exclusive
#                                                       with port/proto)
#   comment    <text>                                  (informational)
#
# Flag combining note for bash callers: `app` cannot pair with
# `port`/`proto`/`from-port`/`to-port` — the validator rejects that
# combination.

# [network.firewall]
# enabled  = false        # opt-in
# incoming = "deny"       # default policy: deny | allow | reject
# outgoing = "allow"
# routed   = "deny"
#
# [[network.firewall.rules]]
# action  = "allow"
# port    = 22
# proto   = "tcp"
# comment = "ssh"
#
# [[network.firewall.rules]]
# action = "allow"
# app    = "OpenSSH"
#
# [[network.firewall.rules]]
# action    = "allow"
# from      = "192.168.1.0/24"
# to        = "any"
# to-port   = 5432
# proto     = "tcp"
# log       = "log"
# comment   = "lan → postgres"

# ---------------------------------------------------------------------------
# [security.keyring] — declarative pacman-key trust
# ---------------------------------------------------------------------------
#
# Each fingerprint is a 40-char upper-hex string with no spaces. To
# trust a key:
#   1. Import the public key:  sudo pacman-key --add /path/to/key.gpg
#   2. Add the fingerprint to the array below.
#   3. Run `shedman apply`.
#
# Adoption: keys you locally-sign by hand (`pacman-key --lsign-key
# <fp>`) get adopted into this array on the next apply.
#
# Safety: removing a fingerprint from the array does NOT auto-revoke
# trust. The reconciler emits a ⚠ warning; revoke by hand with
# `sudo pacman-key --delete <fingerprint>`. Keyring revocation
# requires an explicit user gesture, by design.
#
# Baseline: every fingerprint trusted on first apply (including
# shedos's own install-time chain) is permanently invisible to the
# reconciler — never adopted into TOML, never warned about.

# [security.keyring]
# trusted = [
#     "0123456789ABCDEF0123456789ABCDEF01234567",
#     "FEDCBA9876543210FEDCBA9876543210FEDCBA98",
# ]

# ---------------------------------------------------------------------------
# [[fs.mounts]] — declarative /etc/fstab entries
# ---------------------------------------------------------------------------
#
# Each table below becomes one fstab line inside a marker fence at the
# tail of /etc/fstab. Calamares-shipped entries (root, home, boot,
# swap) are baseline-protected: they live OUTSIDE the fence and are
# never touched, never adopted into TOML, never removed when TOML
# shrinks.
#
# Adoption: hand-edited fstab entries (`vi /etc/fstab`, save) are
# adopted into [[fs.mounts]] on the next `shedman apply`. The `name`
# is auto-derived from the target's last path component; collisions
# get a numeric suffix.
#
# Identity tuple: (device, target). Changing options/fstype/dump/pass
# is an in-place update.
#
# Required: name, device, target, fstype.
# Optional: options (default "defaults"), dump (0), pass (0).
#
# v1: no automatic mount activation. Reboot or `mount -a` to activate
# new entries.

# [[fs.mounts]]
# name    = "data"
# device  = "UUID=DEADBEEF-DEAD-BEEF-DEAD-BEEFDEADBEEF"
# target  = "/mnt/data"
# fstype  = "btrfs"
# options = "noatime,compress=zstd:3,subvol=@data"
# pass    = 2

# [[fs.mounts]]
# name    = "nfs-home"
# device  = "10.0.0.5:/export/home"
# target  = "/mnt/nfs-home"
# fstype  = "nfs"
# options = "defaults,_netdev,noauto,x-systemd.automount"

# ---------------------------------------------------------------------------
# [kernel.cmdline] — declarative Limine kernel parameters
# ---------------------------------------------------------------------------
#
# `append` is a list of tokens to ensure-present in the default Limine
# entry's cmdline= line. Each token is either a flag (`quiet`) or a
# `key=value` pair (`nvidia_drm.modeset=1`); whitespace inside a token
# is rejected.
#
# Adoption: tokens added by hand-editing /boot/limine.conf get pulled
# into `append` on the next `shedman apply`.
#
# Baseline: every cmdline token present on first apply is permanently
# invisible. The installer-baked baseline includes hardware essentials
# (root=, rootflags=, rootfstype=, rw, optional cryptdevice= and
# nvidia_drm.modeset=1) and the UX-critical tokens that suppress the
# first-boot console flash (quiet, splash, loglevel=3,
# rd.udev.log_level=3, fbcon=nodefer,map:99). Removing a baseline
# token from `append` is a no-op; baseline tokens stay in the live
# cmdline forever.
#
# Reboot required: every change reaches the kernel only on the next
# boot. Plan output marks the Change with a "reboot to apply" hint.

# [kernel.cmdline]
# append = [
#     "nvidia_drm.modeset=1",
#     "i915.enable_psr=0",
# ]

# ---------------------------------------------------------------------------
# [[groups]] / [[users]] — declarative groups + users
# ---------------------------------------------------------------------------
#
# Strictly additive, by design. ShedOS NEVER deletes a user or group
# from declarative state — removing a TOML entry only emits a ⚠
# warning. Use `sudo userdel`/`sudo groupdel` by hand if you really
# mean it.
#
# What's declarative:
#   - Group existence (`[[groups]] name = "docker"`)
#   - User existence (`[[users]] name = "shedrack"`)
#   - User shell (at create-time only — `useradd -s ...`)
#   - Group memberships (additive — never `gpasswd -d`)
#
# What's NOT declarative (deferred):
#   - User UID, primary GID, home directory path, password — install-
#     time properties, owned by Calamares.
#   - User deletion / home cleanup.
#   - Re-adding-with-different-shell on existing users.
#
# Adoption: `sudo usermod -aG <group> <user>` typed at the shell
# gets pulled into the user's `groups` list on the next apply.
# `sudo groupadd <name>` is adopted into [[groups]]. Hand-created
# users are adopted into [[users]].
#
# Baseline: every user/group/membership present on first apply
# (Calamares-created primary user, packages' install-scriptlet
# groups like `docker` / `libvirt`, the `wheel` membership) is
# permanently invisible to the reconciler.

# [[groups]]
# name   = "docker"
#
# [[groups]]
# name   = "libvirt"
#
# [[users]]
# name   = "shedrack"
# shell  = "/usr/bin/zsh"
# groups = ["wheel", "docker", "libvirt"]
