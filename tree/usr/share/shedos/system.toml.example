# system.toml.example; the complete, commented reference for
# /etc/shedos/system.toml
#
# Every section ShedOS understands is documented here. Copy the ones you
# want into /etc/shedos/system.toml and run `shedman apply` to reconcile.
# `shedman apply --dry-run` prints the plan without touching anything;
# `shedman apply --validate` only checks syntax.
#
# Two sections — [theme] and [login] — are NOT reconciled by `shedman
# apply`. They are owned by their own subcommands (`shedman theme`,
# `shedman login`) and read directly by the renderer and the login
# screens; apply tolerates them in the file but never acts on them.
#
# The schema version is frozen at 1. shedman apply refuses unknown
# versions with a pointed error; safer than silent reinterpretation. Any
# top-level key not documented here is rejected as an unknown key.

schema = 1

# ---------------------------------------------------------------------------
# [theme]; wallpaper + Catppuccin palette + fonts
# ---------------------------------------------------------------------------
#
# Managed by `shedman theme`, NOT `shedman apply`. Set values with
# `shedman theme set <key> <value>` (re-renders on success) or edit here
# and run `shedman theme apply`. The renderer writes
# /etc/shedos/themes/current/, so hyprland, waybar, walker, GTK, and the
# greeter/lock screen all pick up the change.
#
# All four keys are optional; an omitted key falls back to the shown
# default. `palette` must name a file under
# /etc/shedos/themes/palettes/<name>.toml (see `shedman theme list`); a
# missing palette file is an error. `wallpaper` must be a regular file.

[theme]
wallpaper = "/usr/share/shedos/wallpapers/lumen.png"  # symlinked sharp for the
                                                      # desktop, blurred for the
                                                      # greeter + lock screen
palette   = "catppuccin-mocha-blue"                   # drives every color output
font_ui   = "Inter 11"                                # UI + GNOME interface font
font_mono = "JetBrainsMono Nerd Font"                 # terminals + mono slots

# ---------------------------------------------------------------------------
# [login]; the username field on the greeter and lock screen
# ---------------------------------------------------------------------------
#
# Managed by `shedman login`, NOT `shedman apply`. Read directly by the
# greeter and lock screen on their next launch.
#
# `show_username = true` (default) shows the username dropdown; `false`
# hides it and the password box authenticates the configured user. Toggle
# with `shedman login --hide-username` / `--show-username`. A missing or
# garbled value falls back to true so a broken config never hides the
# field.

[login]
show_username = true

# ---------------------------------------------------------------------------
# [systemd.system] / [systemd.user]
# ---------------------------------------------------------------------------
#
# `enable` ; units that should be enabled (systemctl enable). Missing
#             ones will be enabled on apply.
# `disable`; units that should be disabled. Any enabled ones get
#             disabled on apply.
#
# Each unit name must end in a known suffix (.service, .timer, .socket,
# .target, .mount, .path, .slice). A unit appearing in both enable and
# disable is rejected at validation time (there is no coherent meaning for
# "enable and disable"). Convergent against live systemctl; no baseline or
# adoption — this section only states intent, it never adopts hand-enabled
# units back into TOML.
#
# User units are reconciled via `systemctl --user --global` so they apply
# to every user on this machine. Per-user exceptions are not in v1 scope.

[systemd.system]
enable = [
    "snapper-timeline.timer",
    "snapper-cleanup.timer",
    # Uncomment if this host runs the ShedOS postgres bootstrap:
    # "shedos-pg-initdb.service",
    # Uncomment to enable bluetooth at boot:
    # "bluetooth.service",
]
disable = [
    # "cups.service",   # if you don't print from this box
]

[systemd.user]
enable = [
    "shedos-update-check.timer",
    "shedos-check-health.timer",
    # "shedos-pg-user-bootstrap.service",  # if per-user-db is on
]
disable = []

# ---------------------------------------------------------------------------
# [snapper]; timeline + retention knobs for the `root` config
# ---------------------------------------------------------------------------
#
# Only the TIMELINE_* and NUMBER_LIMIT keys in /etc/snapper/configs/root are
# managed. Everything else (SUBVOLUME, QGROUP, ACL flags, user cleanup
# algos) is left untouched so snapper's own tooling stays authoritative.
#
# Omitting a subkey means "leave current value alone"; not "reset to
# zero". The declarative layer is additive over what snapper ships. If the
# root config doesn't exist yet, apply emits a SKIP advising
# `snapper create-config /` first. Keys are only ever set, never reverted
# when you drop them from TOML.

[snapper.timeline]
enabled = true   # TIMELINE_CREATE
hourly  = 5      # TIMELINE_LIMIT_HOURLY
daily   = 7      # TIMELINE_LIMIT_DAILY
weekly  = 0      # TIMELINE_LIMIT_WEEKLY
monthly = 0      # TIMELINE_LIMIT_MONTHLY
yearly  = 0      # TIMELINE_LIMIT_YEARLY

[snapper.cleanup.number]
limit = 50       # NUMBER_LIMIT — max snapshots before oldest get culled

# ---------------------------------------------------------------------------
# [drop-ins]; file-content entries under /etc/<relpath>
# ---------------------------------------------------------------------------
#
# Keys are paths RELATIVE to /etc; they must contain at least one "/" and
# end in a known config extension (.conf, .json, .rules, .nsswitch, .hosts,
# .cfg). No leading "/" and no ".." segments. Values are the full file
# content as a literal TOML string.
#
# shedman apply tracks ownership of drop-ins in
# /var/lib/shedos/apply.state.json. This is the ONE section with hard
# removal: removing a drop-in from here deletes the file on the next apply.
#
# WARNING: do NOT declare drop-ins that are already managed by a package's
# backup=() entry (sudoers.d/wheel, sddm.conf.d/theme.conf, etc.) —
# shedman apply and pacman will fight over ownership. Stick to bespoke
# drop-ins that no package claims.

# [drop-ins]
# "systemd/coredump.conf.d/50-shedos.conf" = """\
# [Coredump]
# Storage=none
# ProcessSizeMax=0
# """
#
# "sysctl.d/99-shedos-swappiness.conf" = """\
# vm.swappiness = 10
# """

# ---------------------------------------------------------------------------
# [pacman.repos.<name>]; managed stanzas in /etc/pacman.conf
# ---------------------------------------------------------------------------
#
# shedman apply owns a fenced block between `# >>> shedos <<<` and
# `# <<< shedos >>>` in /etc/pacman.conf. The install scriptlet writes the
# initial fence on first install; ongoing edits flow through shedman apply.
#
# Each repo table below becomes one [<name>] stanza inside the fence.
# Anything outside the fence (e.g. [core], [extra], [multilib], or the
# global [options] block) is left strictly alone.
#
# Required keys per repo:
#   server   ; the Server URL (supports $arch)
# Optional:
#   siglevel ; SigLevel directive (default "Required DatabaseRequired")
#
# Dropping the entire [pacman.repos] table removes all managed repos on
# the next apply (the fence stays empty). Removing a single stanza
# removes just that repo.

[pacman.repos.shedos]
server   = "https://repo.shedos.org/stable/$arch"
siglevel = "Required DatabaseRequired"

# Opt in to the canary (testing) channel by uncommenting the block
# below. RC packages land here before reaching [shedos]. Stable cuts
# also publish to /test/x86_64/, so opting in only changes behavior
# during RC windows.
#
# [pacman.repos.shedostest]
# server   = "https://repo.shedos.org/test/$arch"
# siglevel = "Required DatabaseRequired"

# Add your own repo:
# [pacman.repos.my-mirror]
# server   = "https://pkgs.example.org/$repo/$arch"
# siglevel = "Optional TrustAll"

# ---------------------------------------------------------------------------
# [services.postgresql] / [services.docker] / [services.sshd]
# ---------------------------------------------------------------------------
#
# Convenience wrappers that desugar to ordinary systemctl enable/disable
# on the named units, so users don't have to memorise the service names.
# Every flag is optional; an omitted flag leaves that unit untouched
# (unmanaged), it does not force a default.
#
#   [services.postgresql]
#     auto-init   ; true/false → shedos-pg-initdb.service
#     per-user-db ; true/false → shedos-pg-user-bootstrap.service
#   [services.docker].enable ; true/false → docker.service
#   [services.sshd].enable   ; true/false → sshd.service

[services.postgresql]
auto-init   = true   # initialize /var/lib/postgres/data on next boot
per-user-db = true   # bootstrap a per-Linux-user role + database

[services.docker]
enable = true

[services.sshd]
enable = true

# ---------------------------------------------------------------------------
# [network.firewall]; declarative ufw with bidirectional adoption
# ---------------------------------------------------------------------------
#
# UFW ships installed but disabled-by-default on ShedOS; uncomment and
# set `enabled = true` to opt in. ShedOS never enables the firewall for
# you. Merely declaring the [network.firewall] section (even empty)
# engages the reconciler.
#
# Adoption model: rules added via raw `ufw allow|deny` get adopted into
# this section on the next `shedman apply`. So the TOML and `ufw` remain a
# coherent single source of truth; edit either, the file always reflects
# current intent.
#
# Safety: removing a rule from TOML deletes it from ufw on apply.
# Removing the entire `[network.firewall]` section makes the reconciler
# invisible (it stops managing the firewall, including adoption). On first
# apply the baseline is the EMPTY set, so any pre-existing ufw rules are
# adopted (not protected); preview with `shedman apply --dry-run` if that
# matters. State lives in /var/lib/shedos/firewall.{state,baseline}.json.
#
# Defaults & service flag (incoming/outgoing/routed/enabled) are only
# applied when declared. Omit them to leave any user-set values alone.
# Each default policy is one of: allow | deny | reject.
#
# Rule grammar (the union of `man ufw` "RULE SYNTAX"):
#
#   action     allow | deny | reject | limit          (required)
#   direction  in | out | fwd                          (default: in)
#   interface  on <iface>                              (optional)
#   log        log | log-all                           (optional)
#   from       <addr> | <CIDR> | "any"                 (optional)
#   to         <addr> | <CIDR> | "any"                 (optional)
#   from-port  <N> | "<low:high>"                      (requires `from`)
#   to-port    <N> | "<low:high>"                      (requires `to`)
#   port       <N> | "<low:high>"                      (range needs `proto`)
#   proto      tcp | udp | ah | esp | ipv6 | igmp | gre
#   app        <profile name>                          (mutually exclusive
#                                                       with port/proto/
#                                                       from-port/to-port)
#   comment    <text>                                  (informational; not
#                                                       part of rule identity)

# [network.firewall]
# enabled  = false        # opt-in; toggles ufw.service + `ufw enable`
# incoming = "deny"       # default incoming policy
# outgoing = "allow"      # default outgoing policy
# routed   = "deny"       # default routed (forward) policy
#
# [[network.firewall.rules]]
# action  = "allow"
# port    = 22
# proto   = "tcp"
# comment = "ssh"
#
# [[network.firewall.rules]]
# action = "allow"
# app    = "OpenSSH"
#
# [[network.firewall.rules]]
# action    = "allow"
# from      = "192.168.1.0/24"
# to        = "any"
# to-port   = 5432
# proto     = "tcp"
# log       = "log"
# comment   = "lan → postgres"

# ---------------------------------------------------------------------------
# [security.keyring]; declarative pacman-key trust
# ---------------------------------------------------------------------------
#
# Each fingerprint is a 40-char upper-hex string (spaces are stripped). To
# trust a key:
#   1. Import the public key:  sudo pacman-key --add /path/to/key.gpg
#   2. Add the fingerprint to the array below.
#   3. Run `shedman apply` (locally-signs it via `pacman-key --lsign-key`).
#
# Adoption: keys you locally-sign by hand (`pacman-key --lsign-key <fp>`)
# get adopted into this array on the next apply.
#
# Safety: removing a fingerprint from the array does NOT auto-revoke
# trust. The reconciler emits a ⚠ warning; revoke by hand with
# `sudo pacman-key --delete <fingerprint>`. Keyring revocation requires an
# explicit user gesture, by design.
#
# Baseline: every fingerprint trusted on first apply (including shedos's
# own install-time chain) is permanently invisible to the reconciler;
# never adopted into TOML, never warned about. State lives in
# /var/lib/shedos/keyring.{state,baseline}.json.

# [security.keyring]
# trusted = [
#     "0123456789ABCDEF0123456789ABCDEF01234567",
#     "FEDCBA9876543210FEDCBA9876543210FEDCBA98",
# ]

# ---------------------------------------------------------------------------
# [[fs.mounts]]; declarative /etc/fstab entries
# ---------------------------------------------------------------------------
#
# Each table below becomes one fstab line inside a marker fence at the
# tail of /etc/fstab. Calamares-shipped entries (root, home, boot, swap)
# are baseline-protected: they live OUTSIDE the fence and are never
# touched, never adopted into TOML, never removed when TOML shrinks.
#
# Adoption: hand-edited fstab entries (`vi /etc/fstab`, save) are adopted
# into [[fs.mounts]] on the next `shedman apply`. The `name` is
# auto-derived from the target's last path component; collisions get a
# numeric suffix.
#
# Identity tuple: (device, target). Changing options/fstype/dump/pass is
# an in-place update. State lives in
# /var/lib/shedos/mounts.{state,baseline}.json.
#
# Required: name, device, target, fstype.
# Optional:
#   options  ; mount options (default "defaults")
#   required ; bool (default false). Boot safety: non-root entries get
#              `nofail` + `x-systemd.device-timeout=5s` folded in
#              automatically so a missing device can't wedge boot. Set
#              `required = true` to OPT OUT — then an absent device blocks
#              boot (intentional). The `/` mount is always required.
#   dump     ; fstab dump field (default 0)
#   pass     ; fstab fsck order (default 0)
#
# v1: no automatic mount activation. Reboot or `mount -a` to activate
# new entries.

# [[fs.mounts]]
# name     = "data"
# device   = "UUID=DEADBEEF-DEAD-BEEF-DEAD-BEEFDEADBEEF"
# target   = "/mnt/data"
# fstype   = "btrfs"
# options  = "noatime,compress=zstd:3,subvol=@data"
# required = false   # leave boot-safe (nofail) — the default
# dump     = 0
# pass     = 2

# [[fs.mounts]]
# name    = "nfs-home"
# device  = "10.0.0.5:/export/home"
# target  = "/mnt/nfs-home"
# fstype  = "nfs"
# options = "defaults,_netdev,noauto,x-systemd.automount"

# ---------------------------------------------------------------------------
# [kernel.cmdline]; declarative Limine kernel parameters
# ---------------------------------------------------------------------------
#
# `append` is a list of tokens to ensure-present in the default Limine
# entry's cmdline= line. Each token is either a flag (`quiet`) or a
# `key=value` pair (`nvidia_drm.modeset=1`); whitespace inside a token is
# rejected.
#
# Adoption: tokens added by hand-editing /boot/limine.conf get pulled into
# `append` on the next `shedman apply`.
#
# Baseline: every cmdline token present on first apply is permanently
# invisible. The installer-baked baseline includes hardware essentials
# (root=, rootflags=, rootfstype=, rw, optional cryptdevice= and
# nvidia_drm.modeset=1) and the UX-critical tokens that suppress the
# first-boot console flash (quiet, splash, loglevel=3, rd.udev.log_level=3,
# fbcon=nodefer). Removing a baseline token from `append` is a no-op;
# baseline tokens stay in the live cmdline forever. State lives in
# /var/lib/shedos/cmdline.{state,baseline}.json.
#
# Reboot required: every change reaches the kernel only on the next boot.
# Plan output marks the Change with a "reboot to apply" hint.

# [kernel.cmdline]
# append = [
#     "nvidia_drm.modeset=1",
#     "i915.enable_psr=0",
# ]

# ---------------------------------------------------------------------------
# [[groups]] / [[users]]; declarative groups + users
# ---------------------------------------------------------------------------
#
# Strictly additive, by design. ShedOS NEVER deletes a user or group from
# declarative state; removing a TOML entry only emits a ⚠ warning. Use
# `sudo userdel`/`sudo groupdel` by hand if you really mean it.
#
# What's declarative:
#   - Group existence (`[[groups]] name = "docker"`)
#   - Group system flag (`system = true` → `groupadd --system`; creation only)
#   - User existence (`[[users]] name = "shedrack"`)
#   - User shell (at create-time only; `useradd -s ...`)
#   - Group memberships (additive; never `gpasswd -d`)
#
# What's NOT declarative (deferred):
#   - User UID, primary GID, home directory path, password; install-time
#     properties, owned by Calamares.
#   - User deletion / home cleanup.
#   - Re-adding-with-different-shell on existing users (shell is creation-only).
#
# Adoption: `sudo usermod -aG <group> <user>` typed at the shell gets
# pulled into the user's `groups` list on the next apply. `sudo groupadd
# <name>` is adopted into [[groups]]. Hand-created users are adopted into
# [[users]].
#
# Baseline: every user/group/membership present on first apply
# (Calamares-created primary user, packages' install-scriptlet groups like
# `docker` / `libvirt`, the `wheel` membership) is permanently invisible
# to the reconciler. State lives in /var/lib/shedos/{groups,users,
# users-memberships}.{state,baseline}.json.

# [[groups]]
# name   = "docker"
# system = false      # true → create with `groupadd --system`
#
# [[groups]]
# name   = "libvirt"
#
# [[users]]
# name   = "shedrack"
# shell  = "/usr/bin/zsh"          # absolute path; applied only at creation
# groups = ["wheel", "docker", "libvirt"]
