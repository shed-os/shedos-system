# system.toml.example — fully-commented template for /etc/shedos/system.toml
#
# Copy sections you want to customize into /etc/shedos/system.toml and run
# `shedos-apply` to reconcile. `shedos-apply --dry-run` prints the plan
# without touching anything; `shedos-apply --validate` only checks syntax.
#
# The schema version is frozen at 1. shedos-apply refuses unknown versions
# with a pointed error — safer than silent reinterpretation.

schema = 1

# ---------------------------------------------------------------------------
# [systemd.system] / [systemd.user]
# ---------------------------------------------------------------------------
#
# `enable`  — units that should be enabled (systemctl enable). Missing
#             ones will be enabled on apply.
# `disable` — units that should be disabled. Any enabled ones get
#             disabled on apply.
#
# A unit appearing in both enable and disable is rejected at validation
# time (there is no coherent meaning for "enable and disable").
#
# User units are reconciled via `systemctl --user --global` so they apply
# to every user on this machine. Per-user exceptions are not in v1 scope.

[systemd.system]
enable = [
    "snapper-timeline.timer",
    "snapper-cleanup.timer",
    # Uncomment if this host runs the ShedOS postgres bootstrap:
    # "shedos-pg-initdb.service",
    # Uncomment to enable bluetooth at boot:
    # "bluetooth.service",
]
disable = [
    # "cups.service",   # if you don't print from this box
]

[systemd.user]
enable = [
    "shedos-update-check.timer",
    "shedos-check-health.timer",
    # "shedos-pg-user-bootstrap.service",  # if per-user-db is on
]
disable = []

# ---------------------------------------------------------------------------
# [snapper] — timeline + retention knobs for the `root` config
# ---------------------------------------------------------------------------
#
# Only the TIMELINE_* and NUMBER_LIMIT keys in /etc/snapper/configs/root are
# managed. Everything else (SUBVOLUME, QGROUP, ACL flags, user cleanup
# algos) is left untouched so snapper's own tooling stays authoritative.
#
# Omitting a subkey means "leave current value alone" — not "reset to
# zero". The declarative layer is additive over what snapper ships.

[snapper.timeline]
enabled = true   # TIMELINE_CREATE
hourly  = 5      # TIMELINE_LIMIT_HOURLY
daily   = 7      # TIMELINE_LIMIT_DAILY
weekly  = 0      # TIMELINE_LIMIT_WEEKLY
monthly = 0      # TIMELINE_LIMIT_MONTHLY
yearly  = 0      # TIMELINE_LIMIT_YEARLY

[snapper.cleanup.number]
limit = 50       # NUMBER_LIMIT — max snapshots before oldest get culled

# ---------------------------------------------------------------------------
# [drop-ins] — file-content entries under /etc/<relpath>
# ---------------------------------------------------------------------------
#
# Keys are paths RELATIVE to /etc — they must contain at least one "/" and
# end in a known config extension (.conf, .rules, .json, .cfg, ...).
# Values are the full file content as a literal TOML string.
#
# shedos-apply tracks ownership of drop-ins in /var/lib/shedos/apply.state.json.
# Removing a drop-in from here deletes the file on the next apply.
#
# WARNING: do NOT declare drop-ins that are already managed by a package's
# backup=() entry (sudoers.d/wheel, sddm.conf.d/theme.conf, etc.) —
# shedos-apply and pacman will fight over ownership. Stick to bespoke
# drop-ins that no package claims.

# [drop-ins]
# "systemd/coredump.conf.d/50-shedos.conf" = """\
# [Coredump]
# Storage=none
# ProcessSizeMax=0
# """
#
# "sysctl.d/99-shedos-swappiness.conf" = """\
# vm.swappiness = 10
# """

# ---------------------------------------------------------------------------
# [pacman.repos.<name>] — managed stanzas in /etc/pacman.conf
# ---------------------------------------------------------------------------
#
# shedos-apply owns a fenced block between `# >>> shedos <<<` and
# `# <<< shedos >>>` in /etc/pacman.conf. The install scriptlet writes the
# initial fence on first install; ongoing edits flow through shedos-apply.
#
# Each repo table below becomes one [<name>] stanza inside the fence.
# Anything outside the fence (e.g. [core], [extra], [multilib], or the
# global [options] block) is left strictly alone.
#
# Required keys per repo:
#   server    — the Server URL (supports $arch)
# Optional:
#   siglevel  — SigLevel directive (default "Required DatabaseRequired")
#
# Dropping the entire [pacman.repos] table removes all managed repos on
# the next apply (the fence stays empty). Removing a single stanza
# removes just that repo.

[pacman.repos.shedos]
server   = "https://repo.shedos.org/$arch"
siglevel = "Required DatabaseRequired"

# Add your own repo:
# [pacman.repos.my-mirror]
# server   = "https://pkgs.example.org/$repo/$arch"
# siglevel = "Optional TrustAll"

# ---------------------------------------------------------------------------
# [services.postgresql] — declarative wrapper over the bootstrap units
# ---------------------------------------------------------------------------
#
# Flips below desugar to ordinary systemctl enable/disable on the two
# shedos-pg-* units. Convenience-named so users who don't run Postgres
# don't have to think about the underlying service names.
#
# Setting `auto-init = false` stops /var/lib/postgres/data from being
# initialized on next boot. Setting `per-user-db = false` skips the
# per-Linux-user role+database bootstrap.

[services.postgresql]
auto-init   = true   # controls shedos-pg-initdb.service
per-user-db = true   # controls shedos-pg-user-bootstrap.service
