[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kbd
Target = mkinitcpio
Target = shedos-system
Target = linux-zen
Target = linux-zen-headers

[Action]
Description = Migrating legacy mkinitcpio HOOKS to systemd + sd-vconsole...
When = PreTransaction
Exec = /usr/lib/shedos/migrate-mkinitcpio-hooks.sh
AbortOnFail
