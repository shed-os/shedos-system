# Mirrors 90-mkinitcpio-install.hook's triggers (which runs first by
# number): whenever mkinitcpio rebuilds an initramfs, the rendered
# config AND the kernel/initramfs copies on the FAT boot volume must
# follow — Limine boots from there, not from /boot on btrfs.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

# AbortOnFail: the transaction is already committed by PostTransaction, so
# this can't roll back — but it turns a failed ESP sync (a full FAT volume
# that would otherwise silently truncate a kernel image) into a visible
# pacman error instead of a green light over a half-synced boot volume.
[Action]
Description = Updating limine.conf + boot-volume kernels...
When = PostTransaction
NeedsTargets
Exec = /usr/lib/shedos/render-limine-config.sh
AbortOnFail
