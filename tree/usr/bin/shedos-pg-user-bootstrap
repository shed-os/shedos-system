#!/usr/bin/env bash
# shedos-pg-user-bootstrap — ensure each regular Linux user has a matching
# postgres LOGIN+CREATEDB role and a same-named database they own.
#
# Belt-and-suspenders for the Calamares-time bootstrap in shedos_finalize:
# if that fails silently for any reason, this oneshot unit catches it on
# first (and every) boot. Idempotent: existing roles/databases are left
# alone. No password is set — Arch's default pg_hba has `local all all
# peer` so the OS user connects with no flags; they can set a password
# later with psql \password if they want TCP auth.

set -u

# Type=notify on postgresql.service means the unit reports active only when
# postgres is actually accepting connections — but we still do a short
# pg_isready spin as belt-and-suspenders, because we're also reachable via
# manual invocation.
for _ in $(seq 1 30); do
    if runuser -u postgres -- pg_isready -q -h /run/postgresql 2>/dev/null; then
        break
    fi
    sleep 1
done

if ! runuser -u postgres -- pg_isready -q -h /run/postgresql 2>/dev/null; then
    echo "shedos-pg-user-bootstrap: postgresql not ready after 30s; aborting" >&2
    exit 0   # don't fail the boot; postgres might simply be disabled
fi

# Regular users: UID 1000..59999 (system users are <1000, nobody is 65534).
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | while IFS= read -r user; do
    [[ -z "$user" ]] && continue

    role_exists=$(runuser -u postgres -- psql -tAX \
        -c "SELECT 1 FROM pg_roles WHERE rolname = '${user}'" 2>/dev/null || true)
    if [[ "$role_exists" != "1" ]]; then
        echo "shedos-pg-user-bootstrap: creating role $user"
        runuser -u postgres -- psql -v ON_ERROR_STOP=1 \
            -c "CREATE ROLE \"$user\" WITH LOGIN CREATEDB;" || {
                echo "shedos-pg-user-bootstrap: CREATE ROLE $user failed" >&2
                continue
            }
    fi

    db_exists=$(runuser -u postgres -- psql -tAX \
        -c "SELECT 1 FROM pg_database WHERE datname = '${user}'" 2>/dev/null || true)
    if [[ "$db_exists" != "1" ]]; then
        echo "shedos-pg-user-bootstrap: creating database $user owner $user"
        runuser -u postgres -- psql -v ON_ERROR_STOP=1 \
            -c "CREATE DATABASE \"$user\" OWNER \"$user\";" || {
                echo "shedos-pg-user-bootstrap: CREATE DATABASE $user failed" >&2
            }
    fi
done
