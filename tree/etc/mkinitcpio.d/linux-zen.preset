# mkinitcpio preset for the 'linux-zen' package.
#
# ShedOS ships this instead of relying on mkinitcpio's auto-generated
# preset: the stock template (/usr/share/mkinitcpio/hook.preset) enables
# 'default' only, so without this the limine "(Fallback)" recovery entry
# would have no initramfs to load.
#
# Do NOT add ALL_config="/etc/mkinitcpio.conf"; setting it forces
# mkinitcpio into -c <file> mode, which silently disables conf.d
# drop-ins and strips the archiso hooks needed for live-ISO boot.

ALL_kver="/boot/vmlinuz-linux-zen"

# shedos-kernel-only systems (before the migration to linux-zen) don't
# have this kernel yet. mkinitcpio -P would then die on the missing -k
# path during every kernel transaction — the -k value is a non-empty but
# unreadable path, so check_path fails fatally. Define no presets until
# the kernel is in place: mkinitcpio builds nothing for this file instead
# of erroring, and picks the images up once linux-zen lands.
if [[ -e $ALL_kver ]]; then
    PRESETS=('default' 'fallback')
else
    PRESETS=()
fi

default_image="/boot/initramfs-linux-zen.img"

# Build the default image with every module (skip autodetect), like the
# fallback. autodetect only bundles modules loaded at build time, which is
# accurate solely when the building kernel is the booting kernel — false
# during the shedos-kernel→linux-zen migration and on any cross-kernel
# rebuild (a recovery chroot, an offline regen). A wrong guess drops the
# SATA/AHCI root controller and the first boot panics with "Unable to
# mount root". Every module costs ~40 MiB either way; the GPU firmware
# that used to bloat this image is gone with the kms hook, not autodetect,
# so there is no size win worth risking a missing root driver.
default_options="-S autodetect"

fallback_image="/boot/initramfs-linux-zen-fallback.img"
fallback_options="-S autodetect"
