# Larger read-ahead on rotational devices only.
#
# Kernel default is 128 KB. On HDDs, sequential I/O is dominated by seek
# cost (5-10 ms per random head movement), not by transfer rate. Bumping
# read-ahead to 1024 KB amortises each seek across 8x more useful payload
# without measurably increasing memory pressure.
#
# SSDs explicitly skipped; they serve 1024 KB just as fast as 128 KB
# from random offsets, so there's no benefit and the prefetched pages
# evict cache that would have been more useful.

ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{bdi/read_ahead_kb}="1024"
